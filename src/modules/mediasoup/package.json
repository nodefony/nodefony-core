{
  "name": "@nodefony/mediasoup",
  "version": "10.0.0-poc.1",
  "description": "Module applicatif mediasoup — banc test ORM (schémas Drizzle) + build Vue 3 (front non implémenté)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "mediasoup",
    "vue",
    "vite",
    "drizzle",
    "orm"
  ],
  "dependencies": {
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/http": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/drizzle": "*",
    "drizzle-orm": "*",
    "vite": ">=8.0.0",
    "@vitejs/plugin-vue": ">=6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "4.1.8",
    "rimraf": "6.1.3",
    "rollup": "4.61.1",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "license": "CECILL-B"
}
