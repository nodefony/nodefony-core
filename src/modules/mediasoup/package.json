{
  "name": "@nodefony/mediasoup",
  "version": "10.0.0-poc.1",
  "description": "Module applicatif mediasoup — banc test ORM (schémas Drizzle) + build Vue 3 (front non implémenté)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "mediasoup",
    "vue",
    "vite",
    "drizzle",
    "orm"
  ],
  "dependencies": {
    "tslib": "2.8.1",
    "vue": "3.5.41"
  },
  "peerDependencies": {
    "@nodefony/drizzle": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@vitejs/plugin-vue": ">=6.0.0",
    "drizzle-orm": "*",
    "nodefony": "*",
    "vite": ">=8.2.0"
  },
  "devDependencies": {
    "@nodefony/drizzle": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@types/node": "26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.11"
  },
  "license": "CECILL-B"
}
