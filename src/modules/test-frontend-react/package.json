{
  "name": "@nodefony/test-frontend-react",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — exposes a Vite/React page + bench endpoint",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "react",
    "vite"
  ],
  "dependencies": {
    "@mantine/spotlight": "9.4.2",
    "jose": "6.2.4",
    "mongoose": "9.8.0",
    "mysql2": "3.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tslib": "2.8.1",
    "vue": "3.5.40"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@vitejs/plugin-react": "6.0.4",
    "nodefony": "*",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "nodefony": "*",
    "rimraf": "6.1.3"
  },
  "license": "CECILL-B"
}
