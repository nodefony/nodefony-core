{
  "name": "@nodefony/test-frontend-react",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — exposes a Vite/React page + bench endpoint",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "react",
    "vite"
  ],
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@vitejs/plugin-react": ">=6.0.0",
    "nodefony": "*",
    "vite": ">=8.2.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "nodefony": "*"
  },
  "license": "Apache-2.0"
}
