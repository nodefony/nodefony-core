{
  "name": "@nodefony/test-frontend-react",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — exposes a Vite/React page + bench endpoint",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "react",
    "vite"
  ],
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/http": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "vite": ">=8.0.0",
    "@vitejs/plugin-react": ">=6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "rimraf": "6.1.3",
    "rollup": "4.61.1",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3"
  },
  "license": "CECILL-B"
}
