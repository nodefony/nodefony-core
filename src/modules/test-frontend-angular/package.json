{
  "name": "@nodefony/test-frontend-angular",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — Vite/Angular 21 page validating multi-framework",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "angular",
    "vite"
  ],
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/http": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@angular/build": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "rollup": "4.61.1",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3"
  },
  "license": "CECILL-B"
}
