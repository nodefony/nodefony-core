{
  "name": "@nodefony/test-frontend-angular",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — Vite/Angular 21 page validating multi-framework",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "angular",
    "vite"
  ],
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "vite": ">=8.2.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.4",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@types/node": "26.6.2",
    "nodefony": "*"
  },
  "license": "Apache-2.0"
}
