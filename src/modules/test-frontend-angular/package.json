{
  "name": "@nodefony/test-frontend-angular",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — Vite/Angular 21 page validating multi-framework",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "angular",
    "vite"
  ],
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@angular/build": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.1.1",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3"
  },
  "license": "CECILL-B"
}
