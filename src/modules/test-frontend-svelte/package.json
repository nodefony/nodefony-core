{
  "name": "@nodefony/test-frontend-svelte",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — Vite/Svelte 5 page validating multi-framework",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "svelte",
    "vite"
  ],
  "dependencies": {
    "svelte": "5.57.1",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@sveltejs/vite-plugin-svelte": ">=7.0.0",
    "nodefony": "*",
    "vite": ">=8.2.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "26.6.2",
    "nodefony": "*"
  },
  "license": "Apache-2.0"
}
