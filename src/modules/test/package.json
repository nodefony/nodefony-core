    "@nodefony/realtime": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "nodefony": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.16.0",
