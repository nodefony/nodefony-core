{
  "name": "@nodefony/test",
  "version": "10.0.0",
  "description": "nodefony test",
  "author": "admin <admin@nodefony.com>",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:perf": "cross-env NF_RUN_PERF=1 vitest run --passWithNoTests"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "peerDependencies": {
    "@nodefony/drizzle": "*",
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/realtime": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nodefony/drizzle": "*",
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/realtime": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "@types/node": "26.4.1",
    "cross-env": "10.1.0",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.11",
    "zod": "^4.4.3"
  },
  "license": "",
