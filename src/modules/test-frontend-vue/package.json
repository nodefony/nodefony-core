{
  "name": "@nodefony/test-frontend-vue",
  "version": "10.0.0-poc.1",
  "description": "POC consumer module for @nodefony/frontend — Vite/Vue 3 page validating multi-framework",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "poc",
    "vue",
    "vite"
  ],
  "dependencies": {
    "tslib": "2.8.1",
    "vue": "3.5.41"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@vitejs/plugin-vue": ">=6.0.0",
    "nodefony": "*",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "nodefony": "*",
    "rimraf": "6.1.3"
  },
  "license": "CECILL-B"
}
