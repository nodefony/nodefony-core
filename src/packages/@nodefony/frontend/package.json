{
  "name": "@nodefony/frontend",
  "version": "10.0.0",
  "description": "Frontend builder Nodefony — Vite multi-framework (Vue/React/Svelte) intégré, successeur webpackService legacy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
    "nodefony",
    "frontend",
    "vite",
    "react",
    "vue",
    "svelte",
    "typescript"
  ],
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@types/chai": "5.2.3",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "chai": "6.2.2",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "private": false,
  "license": "CECILL-B",
  "dependencies": {
    "tslib": "2.8.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/frontend"
  },
  "homepage": "https://github.com/nodefony/nodefony-core/tree/HEAD/src/packages/@nodefony/frontend#readme",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
