{
  "name": "@nodefony/frontend",
  "version": "10.0.0-beta.6",
  "description": "Construction et rechargement à chaud des frontends de chaque module Nodefony — Vite intégré, multi-framework (React, Vue, Angular, Svelte)",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
    "nodefony",
    "frontend",
    "vite",
    "hmr",
    "react",
    "vue",
    "angular",
    "svelte",
    "typescript",
    "esm"
  ],
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-beta.6",
    "@nodefony/http": "^10.0.0-beta.6",
    "nodefony": "^10.0.0-beta.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.0-beta.6",
    "@nodefony/http": "^10.0.0-beta.6",
    "@types/chai": "5.2.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "nodefony": "^10.0.0-beta.6",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "private": false,
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "2.9.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/frontend"
  },
  "homepage": "https://nodefony.net/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
