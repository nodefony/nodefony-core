{
  "name": "@nodefony/framework",
  "version": "10.0.0",
  "description": "nodefony framework",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "dependencies": {
    "@graphql-tools/merge": "9.2.0",
    "@graphql-tools/schema": "10.0.36",
    "eta": "4.6.0",
    "graphql": "17.0.2",
    "reflect-metadata": "0.2.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "chai": "6.2.2",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "tsx": "4.23.0",
    "vitest": "4.1.10"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
