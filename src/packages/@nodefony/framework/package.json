{
  "name": "@nodefony/framework",
  "version": "10.0.0-alpha.4",
  "description": "Le modèle de programmation Nodefony : routeur, contrôleurs, décorateurs et vues — HTTP et WebSocket dans le même contexte",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "framework",
    "router",
    "controller",
    "decorators",
    "mvc",
    "typescript",
    "esm",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/framework"
  },
  "dependencies": {
    "@graphql-tools/merge": "9.2.4",
    "@graphql-tools/schema": "10.1.1",
    "eta": "4.6.0",
    "graphql": "17.0.2",
    "reflect-metadata": "0.2.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nodefony/http": "^10.0.0-alpha.4",
    "@types/chai": "5.2.3",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "chai": "6.2.2",
    "nodefony": "^10.0.0-alpha.4",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  },
  "license": "Apache-2.0",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "@nodefony/http": "^10.0.0-alpha.4",
    "nodefony": "^10.0.0-alpha.4",
    "zod": "^4.6.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
