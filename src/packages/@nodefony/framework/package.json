{
  "name": "@nodefony/framework",
  "version": "10.0.0",
  "description": "nodefony framework",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "dependencies": {
    "@graphql-tools/merge": "9.1.9",
    "@graphql-tools/schema": "10.0.33",
    "bluebird": "3.7.2",
    "eta": "4.6.0",
    "graphql": "17.0.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/bluebird": "3.5.42",
    "@types/chai": "5.2.3",
    "@types/node": "26.0.1",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitest/coverage-v8": "4.1.8",
    "chai": "6.2.2",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "rollup-plugin-copy": "3.5.0",
    "rollup-sourcemap-path-transform": "1.2.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "nodefony": "*",
    "zod": "^4.4.3"
  }
}
