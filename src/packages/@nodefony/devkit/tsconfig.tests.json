{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // `rootDir` est hérité à `./` du tsconfig de BUILD, où il borne la structure
    // de sortie. Ici il n'y a pas de sortie (`noEmit`) : il ne sert plus qu'à
    // lever `TS6059` dès que `vitest.config.ts` importe un socle de la racine du
    // dépôt (`vitest.oxc.ts`, `vitest.perf.ts`). Remonté à la racine pour que ce
    // paquet — le SEUL à typechecker sa configuration Vitest — puisse continuer
    // de le faire.
    "rootDir": "../../../..",
    // Les socles de la racine s'importent avec leur extension `.ts` — Vite
    // l'exige pour son chargeur de configuration natif, qui deviendra le défaut
    // (#410). TypeScript ne l'accepte que sous ce drapeau, lui-même conditionné
    // à `noEmit` : rien n'est émis ici, la condition est remplie.
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["tests/**/*.ts", "nodefony/tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
