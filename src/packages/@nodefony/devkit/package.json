{
  "name": "@nodefony/devkit",
  "version": "10.0.0",
  "type": "module",
  "description": "Outillage de développement d'une application Nodefony : carte de visite du projet et portes de découverte pour un agent de développement",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "zod": "^4.4.3",
    "playwright": "^1.50.0",
    "lighthouse": "^13.0.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*"
  },
  "dependencies": {
    "axe-core": "4.13.0",
    "tslib": "2.8.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/devkit"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "CECILL-B",
  "keywords": [
    "nodefony",
    "devkit",
    "developer-tools",
    "agent",
    "scaffolding",
    "typescript",
    "esm"
  ]
}
