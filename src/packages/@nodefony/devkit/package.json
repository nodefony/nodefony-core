{
  "name": "@nodefony/devkit",
  "version": "10.0.0",
  "type": "module",
  "description": "Outillage de developpement d une application Nodefony : carte de visite et portes de decouverte pour un agent",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "zod": "^4.4.3",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*"
  },
  "dependencies": {
    "axe-core": "4.13.0",
    "tslib": "2.8.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
