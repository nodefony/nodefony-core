{
  "name": "@nodefony/devkit",
  "version": "10.0.0",
  "type": "module",
  "description": "Outillage de developpement d une application Nodefony : carte de visite et portes de decouverte pour un agent",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/framework": "*",
    "zod": "^4.4.3",
    "@nodefony/http": "*"
  },
  "devDependencies": {
    "nodefony": "*",
    "@nodefony/framework": "*",
    "@nodefony/http": "*"
  },
  "dependencies": {
    "tslib": "2.8.1"
  }
}
