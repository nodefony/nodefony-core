{
  "name": "@nodefony/drizzle",
  "version": "10.0.0-alpha.4",
  "description": "Moteur SQL de Nodefony sur Drizzle ORM (SQLite, PostgreSQL, MySQL) : dépôts typés, migrations de schéma et adoption d'une base existante",
  "nodefony": {
    "storeKind": "durable",
    "stores": [
      "session",
      "user",
      "tokens",
      "passkeys",
      "totp",
      "audit",
      "webhooks",
      "idempotency"
    ]
  },
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "generate:migrations": "tsx scripts/generate-migrations.ts",
    "check:migrations": "tsx scripts/check-migrations-drift.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "vitest run --config vitest.config.load.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "orm",
    "drizzle",
    "sql",
    "sqlite",
    "postgresql",
    "mysql",
    "migrations",
    "typescript",
    "esm"
  ],
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "tslib": "2.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/orm-core": "^10.0.0-alpha.4",
    "@nodefony/security": "^10.0.0-alpha.4",
    "@nodefony/user": "^10.0.0-alpha.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "mysql2": "3.24.4",
    "nodefony": "^10.0.0-alpha.4",
    "pg": "8.23.0",
    "rimraf": "6.1.3"
  },
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/orm-core": "^10.0.0-alpha.4",
    "@nodefony/security": "^10.0.0-alpha.4",
    "@nodefony/user": "^10.0.0-alpha.4",
    "better-sqlite3": "^13.0.0",
    "mysql2": "^3.24.0",
    "nodefony": "^10.0.0-alpha.4",
    "pg": "^8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/drizzle"
  },
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "files": [
    "dist",
    "docs",
    "migrations/*/*.sql",
    "migrations/*/meta/_journal.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
