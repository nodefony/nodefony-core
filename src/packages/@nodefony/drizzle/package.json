{
  "name": "@nodefony/drizzle",
  "version": "10.0.0",
  "description": "Nodefony Framework Module Drizzle ORM (adapter orm-core)",
  "nodefony": {
    "storeKind": "durable",
    "stores": [
      "session",
      "user",
      "tokens",
      "passkeys",
      "totp",
      "audit",
      "webhooks",
      "idempotency"
    ]
  },
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "vitest run --config vitest.config.load.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "typescript",
    "drizzle",
    "orm"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "tslib": "2.8.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "mysql2": "3.23.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "nodefony": "*",
    "rimraf": "6.1.3"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "nodefony": "*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/drizzle"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
