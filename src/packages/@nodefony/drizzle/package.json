{
  "name": "@nodefony/drizzle",
  "version": "10.0.0",
  "description": "Nodefony Framework Module Drizzle ORM (adapter orm-core)",
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && npm run rollup",
    "clean": "rimraf dist",
    "rollup": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "vitest run --config vitest.config.load.ts"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "typescript",
    "drizzle",
    "orm"
  ],
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "tslib": "2.8.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*",
    "@nodefony/security": "*",
    "@nodefony/user": "*",
    "nodefony": "*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/drizzle"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
