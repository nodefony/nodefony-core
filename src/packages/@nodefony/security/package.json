{
  "name": "@nodefony/security",
  "version": "10.0.0",
  "description": "nodefony security",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "arctic": "^3.7.0",
    "jose": "6.2.8",
    "tslib": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/user": "*",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.10"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/user": "*",
    "nodefony": "*"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
