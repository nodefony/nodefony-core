{
  "name": "@nodefony/security",
  "version": "10.0.0-alpha.4",
  "description": "Pare-feu applicatif par zones pour Nodefony : authentification, autorisation par rôles, protection CSRF, journal d'audit",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "security",
    "firewall",
    "authentication",
    "authorization",
    "rbac",
    "csrf",
    "jwt",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/security"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.1",
    "jose": "6.2.12",
    "tslib": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/user": "^10.0.0-alpha.4",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "nodefony": "^10.0.0-alpha.4",
    "rimraf": "6.1.3",
    "vitest": "5.0.0"
  },
  "license": "CECILL-B",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/user": "^10.0.0-alpha.4",
    "nodefony": "^10.0.0-alpha.4"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
