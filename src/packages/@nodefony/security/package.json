{
  "name": "@nodefony/security",
  "version": "10.0.0",
  "description": "nodefony security",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && npm run rollup",
    "rollup": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "test": "node -e \"console.log('test')\""
  },
  "private": true,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "6.0.3"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
