{
  "name": "@nodefony/security",
  "version": "10.0.2",
  "description": "Zone-based application firewall for Nodefony: OAuth2/OIDC, WebAuthn, TOTP 2FA, API tokens, role-based authorization, CSRF, webhooks, audit log",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "main": "./dist/index.js",
  "type": "module",
  "nodefony": {
    "consumesStores": true,
    "contribute": "./dist/nodefony/scaffold/contribute.js"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "nodefony-source": "./index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "nodefony-source": "./nodefony/testing/index.ts",
      "types": "./dist/types/nodefony/testing/index.d.ts",
      "import": "./dist/nodefony/testing/index.js",
      "default": "./dist/nodefony/testing/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "keywords": [
    "nodefony",
    "security",
    "firewall",
    "authentication",
    "authorization",
    "rbac",
    "csrf",
    "jwt",
    "typescript",
    "esm",
    "oauth2",
    "oidc",
    "webauthn",
    "totp",
    "2fa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/security"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "jose": "6.2.18",
    "tslib": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.2",
    "@nodefony/http": "^10.0.2",
    "@nodefony/user": "^10.0.2",
    "@types/node": "26.6.7",
    "@vitest/coverage-v8": "5.1.1",
    "nodefony": "^10.0.2",
    "vitest": "5.1.1"
  },
  "license": "Apache-2.0",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "@nodefony/framework": "^10.0.2",
    "@nodefony/http": "^10.0.2",
    "@nodefony/user": "^10.0.2",
    "nodefony": "^10.0.2"
  },
  "files": [
    "dist",
    "docs",
    "keycloak"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.net/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
