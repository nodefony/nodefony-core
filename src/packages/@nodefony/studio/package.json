{
  "name": "@nodefony/studio",
  "version": "10.0.0",
  "description": "Studio — admin web Nodefony (successeur monitoring-bundle). Frontend React 19 + Mantine v9 + MobX via @nodefony/frontend.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && npm run build:ui",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p frontend/tsconfig.json",
    "build:ui": "vite build --config frontend/vite.config.publish.mts",
    "prepack": "npm run build"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "studio",
    "admin",
    "react",
    "mantine",
    "mobx",
    "vite"
  ],
  "dependencies": {
    "@mantine/core": "9.5.0",
    "@mantine/dates": "9.5.0",
    "@mantine/form": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@mantine/modals": "9.5.0",
    "@mantine/notifications": "9.5.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dagre": "0.7.54",
    "@xyflow/react": "12.11.2",
    "dagre": "0.8.5",
    "dayjs": "^1.11.21",
    "mermaid": "^11.16.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@vitejs/plugin-react": "6.0.5",
    "nodefony": "*",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@types/chai": "5.2.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.10"
  },
  "license": "CECILL-B",
  "files": [
    "dist",
    "public",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
