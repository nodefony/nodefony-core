{
  "name": "@nodefony/studio",
  "version": "10.0.0-poc.1",
  "description": "Studio — admin web Nodefony (successeur monitoring-bundle). Frontend React 19 + Mantine v8 + MobX via @nodefony/frontend.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "studio",
    "admin",
    "react",
    "mantine",
    "mobx",
    "vite"
  ],
  "dependencies": {
    "@mantine/core": "^9.2.2",
    "@mantine/dates": "^9.2.2",
    "@mantine/form": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@mantine/modals": "^9.2.2",
    "@mantine/notifications": "^9.2.2",
    "@mantine/spotlight": "^9.2.2",
    "@tabler/icons-react": "^3.26.0",
    "@tanstack/react-table": "^8.21.0",
    "@types/dagre": "0.7.54",
    "@xyflow/react": "12.10.2",
    "dagre": "0.8.5",
    "dayjs": "^1.11.13",
    "mermaid": "^11.4.1",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.0"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@vitejs/plugin-react": ">=4.0.0",
    "nodefony": "*",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/node": "25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.7",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "CECILL-B"
}
