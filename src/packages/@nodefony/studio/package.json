{
  "name": "@nodefony/studio",
  "version": "10.0.0-poc.1",
  "description": "Studio — admin web Nodefony (successeur monitoring-bundle). Frontend React 19 + Mantine v9 + MobX via @nodefony/frontend.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "studio",
    "admin",
    "react",
    "mantine",
    "mobx",
    "vite"
  ],
  "dependencies": {
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/form": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@mantine/modals": "^9.4.0",
    "@mantine/notifications": "^9.4.0",
    "@mantine/spotlight": "^9.4.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/dagre": "0.7.54",
    "@xyflow/react": "12.11.1",
    "dagre": "0.8.5",
    "dayjs": "^1.11.21",
    "mermaid": "^11.16.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "qrcode.react": "4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@vitejs/plugin-react": "6.0.2",
    "nodefony": "*",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.8",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "license": "CECILL-B"
}
