{
  "name": "@nodefony/studio",
  "version": "10.0.0-beta.2",
  "description": "Console d'administration web de Nodefony : modules, routes, services, configuration effective, journaux et métriques en temps réel",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json && npm run build:ui",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p frontend/tsconfig.json",
    "build:ui": "vite build --config frontend/vite.config.publish.mts"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "admin",
    "dashboard",
    "monitoring",
    "react",
    "studio",
    "typescript",
    "esm"
  ],
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-beta.2",
    "@nodefony/frontend": "^10.0.0-beta.2",
    "@nodefony/http": "^10.0.0-beta.2",
    "@nodefony/realtime": "^10.0.0-beta.2",
    "nodefony": "^10.0.0-beta.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mantine/core": "9.7.1",
    "@mantine/dates": "9.7.1",
    "@mantine/form": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mantine/modals": "9.7.1",
    "@mantine/notifications": "9.7.1",
    "@nodefony/framework": "^10.0.0-beta.2",
    "@nodefony/frontend": "^10.0.0-beta.2",
    "@nodefony/http": "^10.0.0-beta.2",
    "@nodefony/realtime": "^10.0.0-beta.2",
    "@simplewebauthn/browser": "14.0.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-table": "9.2.6",
    "@types/chai": "5.2.3",
    "@types/dagre": "0.7.54",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@xyflow/react": "12.12.0",
    "dagre": "0.8.5",
    "dayjs": "^1.11.23",
    "mermaid": "^12.1.0",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "nodefony": "^10.0.0-beta.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1",
    "tslib": "2.8.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "public",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/studio"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
