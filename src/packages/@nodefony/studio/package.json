{
  "name": "@nodefony/studio",
  "version": "10.0.0",
  "description": "Console d'administration web de Nodefony : modules, routes, services, configuration effective, journaux et métriques en temps réel",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && npm run build:ui",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p frontend/tsconfig.json",
    "build:ui": "vite build --config frontend/vite.config.publish.mts",
    "prepack": "npm run build"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "admin",
    "dashboard",
    "monitoring",
    "react",
    "studio",
    "typescript",
    "esm"
  ],
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "nodefony": "*"
  },
  "devDependencies": {
    "@mantine/core": "9.6.0",
    "@mantine/dates": "9.6.0",
    "@mantine/form": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@mantine/modals": "9.6.0",
    "@mantine/notifications": "9.6.0",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "@nodefony/http": "*",
    "@nodefony/realtime": "*",
    "@simplewebauthn/browser": "14.0.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-table": "9.2.4",
    "@types/chai": "5.2.3",
    "@types/dagre": "0.7.54",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@xyflow/react": "12.11.6",
    "dagre": "0.8.5",
    "dayjs": "^1.11.23",
    "mermaid": "^11.17.2",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "nodefony": "*",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "6.1.3",
    "tslib": "2.8.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "license": "CECILL-B",
  "files": [
    "dist",
    "public",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/studio"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
