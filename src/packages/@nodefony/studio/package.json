{
  "name": "@nodefony/studio",
  "version": "10.0.0-poc.1",
  "description": "Studio — admin web Nodefony (successeur monitoring-bundle). Frontend React 19 + Mantine v8 + MobX via @nodefony/frontend.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "frontend:vite-only": "vite --config frontend/vite.config.generated.mjs"
  },
  "private": true,
  "keywords": ["nodefony", "studio", "admin", "react", "mantine", "mobx", "vite"],
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.0",
    "@mantine/core": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/form": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@mantine/modals": "^8.0.0",
    "@mantine/dates": "^8.0.0",
    "@mantine/charts": "^8.0.0",
    "@mantine/spotlight": "^8.0.0",
    "@tabler/icons-react": "^3.26.0",
    "@tanstack/react-table": "^8.21.0",
    "recharts": "^2.15.0",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/http": "*",
    "@nodefony/framework": "*",
    "@nodefony/frontend": "*",
    "vite": ">=5.0.0",
    "@vitejs/plugin-react": ">=4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "rollup-sourcemap-path-transform": "1.2.0",
    "typescript": "6.0.3"
  },
  "license": "CECILL-B"
}
