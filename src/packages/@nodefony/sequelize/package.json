{
  "name": "@nodefony/sequelize",
  "version": "10.0.0",
  "description": "Nodefony Framework Module Sequelize",
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && npm run rollup",
    "clean": "rimraf dist",
    "rollup": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "test": "vitest run"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "javascript"
  ],
  "dependencies": {
    "@alt3/sequelize-to-json-schemas": "^0.3.56",
    "cls-hooked": "^4.2.2",
    "mariadb": "3.5.2",
    "mysql2": "3.22.4",
    "pg": "8.21.0",
    "pg-hstore": "^2.3.4",
    "pgtools": "1.0.1",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "tedious": "18.6.1",
    "umzug": "3.8.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "sequelize-cli": "6.6.5",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/http": "*",
    "@nodefony/orm-core": "*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/sequelize"
  },
