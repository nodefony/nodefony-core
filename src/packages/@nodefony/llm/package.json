{
  "name": "@nodefony/llm",
  "version": "10.0.0-alpha.1",
  "description": "Generic multi-model LLM provider interface for Nodefony",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rollup --config rollup.config.ts --configPlugin typescript",
    "clean": "rimraf dist",
    "dev": "rollup --config rollup.config.ts --configPlugin typescript --watch",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "nodefony": "*"
  },
  "license": "CECILL-B",
  "devDependencies": {
    "nodefony": "*"
  },
  "private": true
}
