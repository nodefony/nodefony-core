{
  "name": "@nodefony/llm",
  "version": "0.0.0",
  "description": "Generic multi-model LLM provider interface for Nodefony",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "nodefony": "*"
  },
  "license": "CECILL-B",
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "nodefony": "*",
    "vitest": "4.1.11"
  },
  "private": true,
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/llm"
  },
  "homepage": "https://github.com/nodefony/nodefony-core/tree/HEAD/src/packages/@nodefony/llm#readme",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
