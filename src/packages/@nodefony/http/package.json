{
  "name": "@nodefony/http",
  "version": "10.0.0",
  "description": "nodefony http",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && npm run rollup",
    "rollup": "npx rollup --config ./rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "TS_NODE_PROJECT=tsconfig.tests.json mocha --config .mocharc.integration.json",
    "coverage": "vitest run --coverage"
  },
  "private": true,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "directories": {
    "lib": "./nodefony",
    "test": "./nodefony/tests"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.0",
    "cli-color": "2.0.4",
    "cookie": "1.1.1",
    "http-terminator": "3.2.0",
    "memcached": "^2.2.2",
    "mime-types": "3.0.2",
    "ms": "^2.1.3",
    "node-forge": "1.4.0",
    "qs": "^6.15.2",
    "serve-static": "2.2.1",
    "uuid": "14.0.0",
    "ws": "8.21.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/cli-color": "2.0.6",
    "@types/mime-types": "3.0.1",
    "@types/mocha": "10.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "25.9.1",
    "@types/node-forge": "1.3.14",
    "@types/qs": "6.15.1",
    "@types/serve-static": "2.2.0",
    "@types/websocket": "1.0.10",
    "@types/ws": "8.18.1",
    "@types/xml2js": "0.4.14",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitest/coverage-v8": "4.1.7",
    "chai": "6.2.2",
    "mocha": "11.7.6",
    "monocart-coverage-reports": "2.12.11",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "rollup-plugin-copy": "3.5.0",
    "rollup-sourcemap-path-transform": "1.2.0",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "nodefony": "*"
  }
}
