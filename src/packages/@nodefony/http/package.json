{
  "name": "@nodefony/http",
  "version": "10.0.0",
  "description": "nodefony http",
  "author": "admin <admin@nodefony.com>",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:memory": "vitest run --config vitest.load.config.ts nodefony/tests/http/memory.test.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "javascript",
    "typescript"
  ],
  "repository": {},
  "directories": {
    "lib": "./nodefony",
    "test": "./nodefony/tests"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.1",
    "cookie": "2.0.1",
    "http-terminator": "3.2.0",
    "mime-types": "3.0.2",
    "ms": "^2.1.3",
    "node-forge": "1.4.0",
    "qs": "^6.15.3",
    "serve-static": "2.2.1",
    "tslib": "2.8.1",
    "ws": "8.21.3",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mime-types": "3.0.1",
    "@types/ms": "2.1.0",
    "@types/node": "26.2.0",
    "@types/node-forge": "1.3.14",
    "@types/qs": "6.15.1",
    "@types/serve-static": "2.2.0",
    "@types/websocket": "1.0.10",
    "@types/ws": "8.18.1",
    "@types/xml2js": "0.4.14",
    "@vitest/coverage-v8": "4.1.11",
    "chai": "6.2.2",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  },
  "license": "",
  "readmeFilename": "README.md",
  "contributors": [],
  "peerDependencies": {
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
