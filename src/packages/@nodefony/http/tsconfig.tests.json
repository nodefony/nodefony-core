{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../../../..",
    "types": ["node", "vitest/globals", "chai"],
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "paths": {
      "@nodefony/mongoose": ["./nodefony/tests/stubs/mongoose.ts"]
    }
  },
  "include": ["tests/**/*.ts", "nodefony/tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
