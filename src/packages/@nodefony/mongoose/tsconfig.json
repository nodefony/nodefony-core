{
  "compilerOptions": {
    "rootDir": "./",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2024",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "stripInternal": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist"
  },
  "include": [
    "index.ts",
    "rolldown.config.ts",
    "src/**/*.ts",
    "nodefony/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "nodefony/tests/**",
    "tests/**",
    "**/*.test.ts"
  ]
}
