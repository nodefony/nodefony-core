{
  "name": "@nodefony/mongoose",
  "version": "10.0.0-beta.6",
  "description": "Moteur MongoDB de Nodefony sur Mongoose : dépôts typés conformes au contrat orm-core",
  "nodefony": {
    "storeKind": "durable",
    "stores": [
      "session",
      "user",
      "tokens",
      "passkeys",
      "totp",
      "audit",
      "webhooks",
      "idempotency"
    ],
    "configSchema": "./dist/nodefony/config/configSchema.js",
    "stability": "experimental"
  },
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "keywords": [
    "nodefony",
    "orm",
    "mongoose",
    "mongodb",
    "nosql",
    "typescript",
    "esm"
  ],
  "dependencies": {
    "mongodb": "7.8.0",
    "mongoose": "9.12.1",
    "tslib": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.0-beta.6",
    "@nodefony/http": "^10.0.0-beta.6",
    "@nodefony/orm-core": "^10.0.0-beta.6",
    "@nodefony/security": "^10.0.0-beta.6",
    "@nodefony/user": "^10.0.0-beta.6",
    "@types/node": "26.6.6",
    "mongodb-memory-server": "11.3.0",
    "nodefony": "^10.0.0-beta.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-beta.6",
    "@nodefony/http": "^10.0.0-beta.6",
    "@nodefony/orm-core": "^10.0.0-beta.6",
    "@nodefony/security": "^10.0.0-beta.6",
    "@nodefony/user": "^10.0.0-beta.6",
    "nodefony": "^10.0.0-beta.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/mongoose"
  },
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "readme.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.net/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
