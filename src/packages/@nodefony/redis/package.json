{
  "name": "@nodefony/redis",
  "version": "10.0.0-alpha.4",
  "description": "Connecteur Redis de Nodefony : dépôts clé-valeur, cache, sessions partagées et transport de diffusion entre instances",
  "nodefony": {
    "storeKind": "cache",
    "stores": [
      "session",
      "tokens",
      "passkeys",
      "idempotency"
    ]
  },
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "redis",
    "cache",
    "session",
    "pubsub",
    "key-value",
    "typescript",
    "esm"
  ],
  "dependencies": {
    "redis": "6.2.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/security": "^10.0.0-alpha.4",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "nodefony": "^10.0.0-alpha.4",
    "rimraf": "6.1.3",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@nodefony/framework": "^10.0.0-alpha.4",
    "@nodefony/http": "^10.0.0-alpha.4",
    "@nodefony/security": "^10.0.0-alpha.4",
    "nodefony": "^10.0.0-alpha.4",
    "zod": "^4.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/redis"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "readme.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
