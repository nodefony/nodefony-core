{
  "name": "@nodefony/redis",
  "version": "10.0.0",
  "description": "Nodefony Framework Module redis",
  "nodefony": {
    "storeKind": "cache",
    "stores": [
      "session",
      "tokens",
      "passkeys",
      "idempotency"
    ]
  },
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "javascript"
  ],
  "dependencies": {
    "@mantine/spotlight": "9.4.2",
    "jose": "6.2.4",
    "mongoose": "9.8.0",
    "mysql2": "3.23.1",
    "redis": "6.1.0",
    "tslib": "2.8.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/security": "*",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@nodefony/security": "*",
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/redis"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "readme.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
