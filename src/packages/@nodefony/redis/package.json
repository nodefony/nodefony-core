{
  "name": "@nodefony/redis",
  "version": "10.0.3",
  "description": "Redis connector for Nodefony: key-value repositories, cache, shared sessions and cross-instance broadcast transport",
  "nodefony": {
    "storeKind": "cache",
    "stores": [
      "session",
      "tokens",
      "passkeys",
      "idempotency"
    ],
    "configSchema": "./dist/nodefony/config/configSchema.js"
  },
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "keywords": [
    "nodefony",
    "redis",
    "cache",
    "session",
    "pubsub",
    "key-value",
    "typescript",
    "esm"
  ],
  "dependencies": {
    "redis": "6.4.0",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@nodefony/framework": "^10.0.3",
    "@nodefony/http": "^10.0.3",
    "@nodefony/security": "^10.0.3",
    "@types/node": "26.6.7",
    "@vitest/coverage-v8": "5.1.1",
    "nodefony": "^10.0.3",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@nodefony/framework": "^10.0.3",
    "@nodefony/http": "^10.0.3",
    "@nodefony/security": "^10.0.3",
    "nodefony": "^10.0.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/redis"
  },
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "readme.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.net/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
