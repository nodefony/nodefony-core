{
  "name": "@nodefony/user",
  "version": "10.0.0-alpha.9",
  "description": "Contrats utilisateur de Nodefony, indépendants de l'ORM : interface IUser, utilisateurs de base, encodeurs de mot de passe et UserService — consommable sans @nodefony/security",
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "nodefony-source": "./index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "tsx tests/load/bcrypt-throughput.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "user",
    "authentication",
    "password",
    "argon2",
    "bcrypt",
    "typescript",
    "esm"
  ],
  "peerDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@node-rs/bcrypt": "^1.10.0",
    "@nodefony/orm-core": "^10.0.0-alpha.9",
    "nodefony": "^10.0.0-alpha.9"
  },
  "peerDependenciesMeta": {
    "@node-rs/bcrypt": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@node-rs/bcrypt": "^1.10.8",
    "@nodefony/orm-core": "^10.0.0-alpha.9",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "nodefony": "^10.0.0-alpha.9",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/user"
  },
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
