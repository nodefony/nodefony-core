{
  "name": "@nodefony/user",
  "version": "10.0.0",
  "description": "Nodefony User Core — IUser contracts, base users, password encoders & UserService (ORM-agnostic, consommable sans @nodefony/security)",
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "tsx tests/load/bcrypt-throughput.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "typescript",
    "user",
    "security",
    "rbac"
  ],
  "peerDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@node-rs/bcrypt": "^1.10.0",
    "@nodefony/orm-core": "*",
    "nodefony": "*"
  },
  "peerDependenciesMeta": {
    "@node-rs/bcrypt": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@node-rs/bcrypt": "^1.10.7",
    "@nodefony/orm-core": "*",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/user"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
