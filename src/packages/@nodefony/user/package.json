{
  "name": "@nodefony/user",
  "version": "10.0.0",
  "description": "Nodefony User Core — IUser contracts, base users, password encoders & UserService (ORM-agnostic, consommable sans @nodefony/security)",
  "contributors": [],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && npm run rollup",
    "rollup": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:load": "tsx tests/load/bcrypt-throughput.ts"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "typescript",
    "user",
    "security",
    "rbac"
  ],
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/orm-core": "*",
    "@node-rs/bcrypt": "^1.10.0",
    "@node-rs/argon2": "^2.0.2"
  },
  "peerDependenciesMeta": {
    "@node-rs/bcrypt": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@node-rs/bcrypt": "^1.10.0",
    "@node-rs/argon2": "^2.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "vitest": "4.1.8",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "glob": "^13.0.6",
    "rimraf": "6.1.3",
    "rollup": "4.61.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/user"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md"
}
