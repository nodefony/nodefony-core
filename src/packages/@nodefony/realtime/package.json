{
  "name": "@nodefony/realtime",
  "version": "10.0.2",
  "nodefony": {
    "configSchema": "./dist/nodefony/config/configSchema.js"
  },
  "description": "Nodefony realtime server: channels, presence, bidirectional JSON-RPC 2.0 calls in JSON or binary CBOR, backpressure, multi-instance fan-out",
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/nodefony/testing/index.d.ts",
      "import": "./dist/nodefony/testing/index.js",
      "default": "./dist/nodefony/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:cluster": "vitest run --config vitest.cluster.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
    "nodefony",
    "realtime",
    "websocket",
    "json-rpc",
    "pubsub",
    "cluster",
    "backpressure",
    "typescript",
    "esm",
    "cbor",
    "presence",
    "binary-websocket"
  ],
  "peerDependencies": {
    "@nodefony/framework": "^10.0.2",
    "@nodefony/http": "^10.0.2",
    "nodefony": "^10.0.2",
    "reflect-metadata": "0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nodefony/drizzle": "^10.0.2",
    "@nodefony/framework": "^10.0.2",
    "@nodefony/http": "^10.0.2",
    "@nodefony/orm-core": "^10.0.2",
    "@nodefony/security": "^10.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "nodefony": "^10.0.2",
    "reflect-metadata": "0.2.2",
    "vitest": "5.1.1"
  },
  "private": false,
  "engines": {
    "node": "^24.16.0 || >=26.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "2.9.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/realtime"
  },
  "homepage": "https://nodefony.net/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
