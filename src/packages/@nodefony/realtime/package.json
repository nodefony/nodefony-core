{
  "name": "@nodefony/realtime",
  "version": "10.0.0",
  "description": "Couche realtime serveur Nodefony — hub WebSocket fan-out, protocole JSON-RPC 2.0, backplane cluster (loopback / cluster IPC / redis) ouvert aux drivers applicatifs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/nodefony/testing/index.d.ts",
      "import": "./dist/nodefony/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
    "nodefony",
    "typescript",
    "realtime",
    "websocket",
    "json-rpc",
    "pub-sub",
    "cluster"
  ],
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "nodefony": "*",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "vitest": "4.1.11"
  },
  "private": false,
  "license": "CECILL-B",
  "dependencies": {
    "tslib": "2.8.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/realtime"
  },
  "homepage": "https://github.com/nodefony/nodefony-core/tree/HEAD/src/packages/@nodefony/realtime#readme",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
