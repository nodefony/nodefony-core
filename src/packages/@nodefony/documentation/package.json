{
  "name": "@nodefony/documentation",
  "version": "10.0.0",
  "description": "Plan de données de documentation de Nodefony : index des pages co-localisées dans chaque module, résolution des variables dynamiques, exposition en lecture pour la console d'administration",
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "clean": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.tests.json"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "documentation",
    "markdown",
    "docs",
    "typescript",
    "esm"
  ],
  "devDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "nodefony": "*",
    "rimraf": "6.1.3",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "nodefony": "*",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/packages/@nodefony/documentation"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "dependencies": {
    "tslib": "2.8.1"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nodefony.github.io/nodefony-core/",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
