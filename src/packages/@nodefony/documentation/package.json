{
  "name": "@nodefony/documentation",
  "version": "10.0.0",
  "description": "Data plane de documentation transverse de Nodefony — index des docs co-localisées, résolution des variables dynamiques {{ }}, exposé en /nodefony/documentation/api/*",
  "contributors": [],
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "rimraf dist && npm run rollup",
    "clean": "rimraf dist",
    "rollup": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rimraf dist && npm run rollup -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "private": false,
  "keywords": [
    "nodefony",
    "documentation",
    "markdown"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "@vitest/coverage-v8": "4.1.7"
  },
  "peerDependencies": {
    "nodefony": "*",
    "@nodefony/framework": "*",
    "@nodefony/http": "*",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git",
    "directory": "src/packages/@nodefony/documentation"
  },
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md"
}
