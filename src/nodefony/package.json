{
  "name": "nodefony",
  "version": "10.0.0",
  "description": "Nodefony Framework",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/client/types/src/client/index.d.ts",
          "default": "./dist/client/client/index.js"
        }
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./client": {
      "types": "./dist/client/types/src/client/index.d.ts",
      "default": "./dist/client/client/index.js"
    },
    "./debugbar": {
      "types": "./dist/client/types/src/client/debugbar/index.d.ts",
      "default": "./dist/client/client/debugbar/index.js"
    },
    "./react": {
      "types": "./dist/client/types/src/client/react/index.d.ts",
      "default": "./dist/client/client/react/index.js"
    },
    "./roles": {
      "types": "./dist/client/types/src/client/roles/index.d.ts",
      "default": "./dist/client/client/roles/index.js"
    },
    "./debugbar.js": "./dist/client/debugbar.standalone.js",
    "./package.json": "./package.json"
  },
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "nodefony": "bin/nodefony"
  },
  "keywords": [
    "nodefony",
    "node-js",
    "javascript"
  ],
  "scripts": {
    "nodefony": "node ./bin/nodefony",
    "build": "rollup --config rollup.config.ts --configPlugin typescript",
    "postbuild": "node -e \"try{require('fs').chmodSync('bin/nodefony',0o755)}catch(e){}\"",
    "dev": "rollup --config rollup.config.ts --configPlugin typescript --watch",
    "clean": "rimraf dist bin/nodefony tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node ./bin/nodefony",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "RUN_PERF=1 vitest run",
    "test:boot": "RUN_CLI_BOOT=1 vitest run",
    "test:all": "RUN_PERF=1 RUN_CLI_BOOT=1 vitest run",
    "coverage": "vitest run --coverage",
    "analyze": "ROLLUP_ANALYZE=true npm run build",
    "lint": "eslint 'src/**/*.ts' 'rollup.config.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'rollup.config.ts'",
    "doc": "typedoc"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "chokidar": "5.0.0",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "eta": "4.6.0",
    "figlet": "1.11.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "mime-types": "3.0.2",
    "reflect-metadata": "0.2.2",
    "rollup": "4.62.2",
    "semver": "7.8.5",
    "terser": "5.48.0",
    "uuid": "14.0.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/figlet": "1.7.0",
    "@types/lodash": "4.17.24",
    "@types/lodash-es": "4.17.12",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitest/coverage-v8": "4.1.8",
    "chai": "6.2.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "mkdirp": "3.0.1",
    "prettier": "3.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "6.1.3",
    "rollup-plugin-polyfill-node": "0.13.0",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md"
}
