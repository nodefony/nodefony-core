{
  "name": "nodefony",
  "version": "10.0.0",
  "description": "Nodefony Framework",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/client/types/src/client/index.d.ts",
          "default": "./dist/client/client/index.js"
        }
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./bundler": {
      "types": "./dist/types/bundler/index.d.ts",
      "import": "./dist/node/bundler/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/node/testing/index.js"
    },
    "./client": {
      "types": "./dist/client/types/src/client/index.d.ts",
      "default": "./dist/client/client/index.js"
    },
    "./debugbar": {
      "types": "./dist/client/types/src/client/debugbar/index.d.ts",
      "default": "./dist/client/client/debugbar/index.js"
    },
    "./react": {
      "types": "./dist/client/types/src/client/react/index.d.ts",
      "default": "./dist/client/client/react/index.js"
    },
    "./roles": {
      "types": "./dist/client/types/src/client/roles/index.d.ts",
      "default": "./dist/client/client/roles/index.js"
    },
    "./debugbar.js": "./dist/client/debugbar.standalone.js",
    "./package.json": "./package.json"
  },
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nodefony": "bin/nodefony"
  },
  "man": [
    "./man/nodefony.1"
  ],
  "keywords": [
    "nodefony",
    "node-js",
    "javascript"
  ],
  "scripts": {
    "nodefony": "node ./bin/nodefony",
    "build": "rimraf dist && rolldown -c rolldown.config.ts && npm run build:types",
    "postbuild": "node -e \"try{require('fs').chmodSync('bin/nodefony',0o755)}catch(e){}\"",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "clean": "rimraf dist bin/nodefony tsconfig.tsbuildinfo",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.tests.json && tsgo --noEmit -p tsconfigClient.json",
    "start": "node ./bin/nodefony",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "cross-env NF_RUN_PERF=1 vitest run",
    "test:boot": "cross-env NF_RUN_CLI_BOOT=1 vitest run",
    "test:all": "cross-env NF_RUN_PERF=1 NF_RUN_CLI_BOOT=1 vitest run",
    "coverage": "vitest run --coverage",
    "doc": "typedoc",
    "typecheck:tsc6": "tsc --noEmit",
    "build:types": "tsgo -p tsconfig.declarations.json && tsgo -p tsconfigClient.json --emitDeclarationOnly"
  },
  "dependencies": {
    "@inquirer/prompts": "8.6.0",
    "chokidar": "5.0.0",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "eta": "4.6.0",
    "figlet": "1.11.4",
    "mime-types": "3.0.2",
    "reflect-metadata": "0.2.2",
    "semver": "7.8.5",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/figlet": "1.7.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "mkdirp": "3.0.1",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "6.1.3",
    "rolldown": "1.2.5",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodefony/nodefony-core.git",
    "directory": "src/nodefony"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "files": [
    "dist",
    "bin",
    "docs",
    "templates",
    ".ai",
    "man"
  ],
  "homepage": "https://github.com/nodefony/nodefony-core/tree/HEAD/src/nodefony#readme",
  "bugs": {
    "url": "https://github.com/nodefony/nodefony-core/issues"
  }
}
