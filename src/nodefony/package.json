{
  "name": "nodefony",
  "version": "10.0.0",
  "description": "Nodefony Framework",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/client/types/src/client/index.d.ts",
          "default": "./dist/client/client/index.js"
        }
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./client": {
      "types": "./dist/client/types/src/client/index.d.ts",
      "default": "./dist/client/client/index.js"
    },
    "./debugbar": {
      "types": "./dist/client/types/src/client/debugbar/index.d.ts",
      "default": "./dist/client/client/debugbar/index.js"
    },
    "./debugbar.js": "./dist/client/debugbar.standalone.js",
    "./package.json": "./package.json"
  },
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "nodefony": "bin/nodefony"
  },
  "keywords": [
    "nodefony",
    "node-js",
    "javascript"
  ],
  "scripts": {
    "nodefony": "node ./bin/nodefony",
    "build": "rollup --config rollup.config.ts --configPlugin typescript",
    "postbuild": "node -e \"try{require('fs').chmodSync('bin/nodefony',0o755)}catch(e){}\"",
    "dev": "rollup --config rollup.config.ts --configPlugin typescript --watch",
    "clean": "rimraf dist bin/nodefony tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node ./bin/nodefony",
    "test": "tsx $(node -e \"process.stdout.write(require.resolve('mocha/bin/mocha.js'))\") 'src/tests/**/*.test.ts' 'src/tests/*.test.ts'",
    "test:cov": "tsx $(node -e \"process.stdout.write(require.resolve('mocha/bin/mocha.js'))\") 'src/tests/**/*.test.ts' 'src/tests/*.test.ts' --invert --grep performance",
    "coverage": "mcr -c mcr.config.js npm run test:cov",
    "analyze": "ROLLUP_ANALYZE=true npm run build",
    "lint": "eslint 'src/**/*.ts' 'rollup.config.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'rollup.config.ts'",
    "doc": "typedoc"
  },
  "dependencies": {
    "@babel/generator": "7.29.1",
    "@babel/parser": "7.29.3",
    "@babel/traverse": "7.29.0",
    "@babel/types": "7.29.0",
    "@inquirer/prompts": "8.4.3",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "asciify": "1.3.5",
    "chokidar": "4.0.3",
    "cli-color": "2.0.4",
    "cli-table3": "0.6.5",
    "clui": "0.3.6",
    "commander": "14.0.3",
    "ejs": "3.1.10",
    "glob": "11.1.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "mime-types": "3.0.2",
    "moment": "2.30.1",
    "node-emoji": "2.2.0",
    "node-fetch": "3.3.2",
    "npm-run-all2": "8.0.4",
    "pm2": "7.0.1",
    "pug": "3.0.4",
    "reflect-metadata": "0.2.2",
    "rollup": "4.60.3",
    "rxjs": "7.8.2",
    "semver": "7.8.0",
    "shelljs": "0.10.0",
    "terser": "5.47.1",
    "twig": "1.17.1",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/asciify": "1.3.34",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/cli-color": "2.0.6",
    "@types/clui": "0.3.5",
    "@types/lodash": "4.17.24",
    "@types/lodash-es": "4.17.12",
    "@types/mime-types": "3.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "25.7.0",
    "@types/semver": "7.7.1",
    "@types/shelljs": "0.10.0",
    "@types/twig": "1.12.17",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "chai": "5.2.1",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jsdom": "26.1.0",
    "mkdirp": "3.0.1",
    "mocha": "11.7.5",
    "monocart-coverage-reports": "2.12.11",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "rollup-plugin-polyfill-node": "0.13.0",
    "rollup-plugin-visualizer": "5.14.0",
    "tslib": "2.8.1",
    "tsx": "4.21.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony.git"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md"
}
