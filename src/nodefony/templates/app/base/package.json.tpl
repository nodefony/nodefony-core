{
  "name": "<%= it.appName %>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application Nodefony — générée par `nodefony create app`",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodefony development",
    "build": "rolldown -c rolldown.config.ts",
    "start": "nodefony production",
    "stop": "nodefony stop",
    "status": "nodefony status",
    "test": "vitest run",
    "test:e2e": "npm run build && RUN_E2E=1 vitest run tests/e2e.test.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."<% if (it.complete) { %>,
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"<% } %>
  },
  "dependencies": {
    "nodefony": "^<%= it.nodefonyVersion %>",
    "@nodefony/http": "^<%= it.nodefonyVersion %>",
    "@nodefony/framework": "^<%= it.nodefonyVersion %>",
<% if (it.complete) { %>    "@nodefony/orm-core": "^<%= it.nodefonyVersion %>",
    "@nodefony/drizzle": "^<%= it.nodefonyVersion %>",
    "@nodefony/user": "^<%= it.nodefonyVersion %>",
    "@nodefony/realtime": "^<%= it.nodefonyVersion %>",
    "@nodefony/security": "^<%= it.nodefonyVersion %>",
    "@nodefony/frontend": "^<%= it.nodefonyVersion %>",
    "@nodefony/studio": "^<%= it.nodefonyVersion %>",
    "@nodefony/redis": "^<%= it.nodefonyVersion %>",
<% } else if (it.front) { %>    "@nodefony/frontend": "^<%= it.nodefonyVersion %>",
<% } %><% if (it.frontend === "react") { %>    "react": "^19.2.7",
    "react-dom": "^19.2.7",
<% } %><% if (it.frontend === "vue") { %>    "vue": "^3.5.39",
<% } %><% if (it.frontend === "angular") { %>    "@angular/core": "^22.0.6",
    "@angular/common": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
<% } %>    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript/native-preview": "^7.0.0-dev.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "rolldown": "^1.1.5",
<% if (it.frontend === "react") { %>    "vite": "^8.1.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
<% } %><% if (it.frontend === "vue") { %>    "vite": "^8.1.4",
    "@vitejs/plugin-vue": "^6.0.7",
<% } %><% if (it.frontend === "angular") { %>    "vite": "^8.1.4",
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular/build": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
<% } %>    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
