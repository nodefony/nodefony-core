<!doctype html>
<html lang="<%= nodefony.locale %>">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Nodefony (https://nodefony.net)" />
    <meta
      name="description"
      content="Nodefony — framework Node.js fullstack pour applications temps réel et agents IA, sécurisé par conception (HTTP + WebSocket natifs)."
    />
    <title><%= nodefony.name %> — accueil</title>
    <style>
      :root {
        --bg: #0b1020; --bg2: #131a31; --fg: #e7ecf6; --muted: #9aa6c2;
        --brand: #0067ba; --brand2: #ff8a3d; --card: #161d33; --border: #263150;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--fg);
        background:
          radial-gradient(1200px 600px at 50% -10%, rgba(0,103,186,.25), transparent 60%),
          radial-gradient(900px 500px at 88% 8%, rgba(255,138,61,.12), transparent 55%),
          linear-gradient(180deg, var(--bg), var(--bg2));
        min-height: 100vh; display: flex; flex-direction: column; align-items: center;
        justify-content: center; padding: 48px 20px;
      }
      .hero { text-align: center; max-width: 820px; }
      .logo { height: 92px; width: auto; filter: drop-shadow(0 6px 22px rgba(0,103,186,.45)); }
      h1 {
        font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 16px 0 6px; letter-spacing: -.02em;
        background: linear-gradient(90deg, var(--brand), var(--brand2));
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .version {
        display: inline-block; font-size: .78rem; color: var(--muted);
        border: 1px solid var(--border); border-radius: 999px; padding: 3px 12px; margin-bottom: 14px;
      }
      .tagline { color: var(--muted); font-size: 1.05rem; margin: 0 auto 8px; line-height: 1.6; }
      .pillars {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px; width: min(880px, 100%); margin-top: 30px;
      }
      .pillar {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: 22px 20px; text-align: left;
      }
      .pillar .pic { color: var(--accent); height: 28px; width: 28px; }
      .pillar h3 { margin: 12px 0 6px; font-size: 1.1rem; }
      .pillar p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
      .label {
        text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; color: var(--muted);
        margin: 40px 0 14px; font-weight: 600;
      }
      .grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px; width: min(880px, 100%);
      }
      .card {
        display: block; text-decoration: none; color: var(--fg); background: var(--card);
        border: 1px solid var(--border); border-radius: 16px; padding: 20px;
        transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
      }
      @media (prefers-reduced-motion: no-preference) { .card:hover { transform: translateY(-4px); } }
      .card:hover { border-color: var(--accent); box-shadow: 0 12px 30px rgba(0,0,0,.35); }
      .card .ic { color: var(--accent); display: inline-flex; height: 34px; align-items: center; }
      .card .ic svg { height: 32px; width: 32px; }
      .card h3 { margin: 10px 0 6px; font-size: 1.15rem; }
      .card p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.5; }
      .card .go { margin-top: 14px; font-size: .82rem; color: var(--accent); font-weight: 600; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; width: min(880px, 100%); }
      .chip {
        display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--fg);
        background: var(--card); border: 1px solid var(--border); border-radius: 999px;
        padding: 8px 16px 8px 12px; font-size: .9rem; transition: border-color .15s ease, color .15s ease;
      }
      .chip:hover { border-color: var(--accent); }
      .chip svg { height: 18px; width: 18px; color: var(--accent); }
      footer { margin-top: 44px; color: var(--muted); font-size: .85rem; }
      footer a { color: var(--brand2); text-decoration: none; }
    </style>
  </head>

  <body>
    <main class="hero">
      <img class="logo" src="data:image/png;base64," alt="Nodefony" draggable="false" />
      <h1><%= nodefony.name %></h1>
      <div class="version">v<%= nodefony.version %></div>
      <p class="tagline">
        Framework Node.js fullstack pour bâtir des applications temps réel
        et des agents IA — sécurisées par conception.
      </p>

      <section class="pillars">
        <div class="pillar" style="--accent:#ff8a3d">
          <svg class="pic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <h3>Temps réel</h3>
          <p>HTTP et WebSocket citoyens de première classe dans le même
             contexte controller. Hub realtime, fan-out cluster Redis.</p>
        </div>
        <div class="pillar" style="--accent:#4FC08D">
          <svg class="pic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <h3>Sécurité</h3>
          <p>Zero Trust par défaut, conformité OWASP &amp; RFC, JWT stateless,
             firewall applicatif. Sécurisé par conception.</p>
        </div>
        <div class="pillar" style="--accent:#a78bfa">
          <svg class="pic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg>
          <h3>IA agentique</h3>
          <p>Plateforme d'agents métier : orchestration LLM, RAG, sous-agents,
             mémoire court/long terme. Observabilité IA-first.</p>
        </div>
      </section>

      <div class="label">Frontends de démo</div>
      <section class="grid">
        <a class="card" style="--accent:#61DAFB" href="/react/app">
          <span class="ic"><svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.345-.034-.46 0-.915.01-1.36.034.44-.572.895-1.096 1.345-1.565zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.098 2.21-.098zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.386zm7.26 0c.695.103 1.365.23 2.006.387-.18.632-.405 1.282-.66 1.933-.2-.39-.41-.783-.64-1.174-.225-.392-.465-.774-.705-1.146zm3.063.675c.484.15.944.317 1.375.498 1.732.74 2.852 1.708 2.852 2.476-.005.768-1.125 1.74-2.857 2.475-.42.18-.88.342-1.355.493-.28-.958-.646-1.956-1.1-2.98.45-1.017.81-2.01 1.085-2.964zm-13.395.004c.278.96.645 1.957 1.1 2.98-.45 1.017-.812 2.01-1.086 2.964-.484-.15-.944-.318-1.37-.5-1.732-.737-2.852-1.706-2.852-2.474 0-.768 1.12-1.742 2.852-2.476.42-.18.88-.342 1.356-.494zm11.678 4.28c.265.657.49 1.312.676 1.948-.64.157-1.316.29-2.016.39.24-.375.48-.762.705-1.158.225-.39.435-.788.636-1.18zm-9.945.02c.2.392.41.783.64 1.175.23.39.465.772.705 1.143-.695-.102-1.365-.23-2.006-.386.18-.63.406-1.282.66-1.933zM17.92 16.32c.112.493.2.968.254 1.423.23 1.868-.054 3.32-.714 3.708-.147.09-.338.128-.563.128-1.012 0-2.514-.807-4.11-2.28.686-.72 1.37-1.536 2.02-2.44 1.107-.118 2.154-.3 3.113-.54zm-11.83.01c.96.234 2.006.415 3.107.532.66.905 1.345 1.727 2.035 2.446-1.595 1.483-3.092 2.295-4.11 2.295-.22-.005-.406-.05-.553-.132-.666-.38-.955-1.834-.73-3.703.054-.46.142-.944.25-1.438zm4.56.64c.44.02.89.034 1.345.034.46 0 .915-.01 1.36-.034-.44.572-.895 1.095-1.345 1.565-.455-.47-.91-.993-1.36-1.565z"/></svg></span>
          <h3>React 19</h3>
          <p>Module front React (Vite + HMR)</p>
          <div class="go">Ouvrir /react/app →</div>
        </a>
        <a class="card" style="--accent:#4FC08D" href="/vue/app">
          <span class="ic"><svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z"/></svg></span>
          <h3>Vue 3</h3>
          <p>Module front Vue 3 (Vite + HMR)</p>
          <div class="go">Ouvrir /vue/app →</div>
        </a>
        <a class="card" style="--accent:#DD0031" href="/angular/app">
          <span class="ic"><svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.712 17.711H7.288l-1.204 2.916L12 24l5.916-3.373-1.204-2.916ZM14.692 0l7.832 16.855.814-12.856L14.692 0ZM9.308 0 .662 3.999l.814 12.856L9.308 0Zm-.405 13.93h6.198L12 6.396 8.903 13.93Z"/></svg></span>
          <h3>Angular</h3>
          <p>Module front Angular (Vite + HMR)</p>
          <div class="go">Ouvrir /angular/app →</div>
        </a>
        <a class="card" style="--accent:#0067ba" href="/nodefony">
          <span class="ic"><img src="data:image/png;base64," alt="" height="30" /></span>
          <h3>Studio</h3>
          <p>Console d'administration &amp; observabilité.</p>
          <div class="go">Ouvrir /nodefony →</div>
        </a>
      </section>

      <div class="label">Construit avec</div>
      <nav class="chips">
        <a class="chip" style="--accent:#5FA04E" href="https://nodejs.org" target="_blank" rel="noreferrer noopener">
          <svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.998,24c-0.321,0-0.641-0.084-0.922-0.247l-2.936-1.737c-0.438-0.245-0.224-0.332-0.08-0.383 c0.585-0.203,0.703-0.25,1.328-0.604c0.065-0.037,0.151-0.023,0.218,0.017l2.256,1.339c0.082,0.045,0.197,0.045,0.272,0l8.795-5.076 c0.082-0.047,0.134-0.141,0.134-0.238V6.921c0-0.099-0.053-0.192-0.137-0.242l-8.791-5.072c-0.081-0.047-0.189-0.047-0.271,0 L3.075,6.68C2.99,6.729,2.936,6.825,2.936,6.921v10.15c0,0.097,0.054,0.189,0.139,0.235l2.409,1.392 c1.307,0.654,2.108-0.116,2.108-0.89V7.787c0-0.142,0.114-0.253,0.256-0.253h1.115c0.139,0,0.255,0.112,0.255,0.253v10.021 c0,1.745-0.95,2.745-2.604,2.745c-0.508,0-0.909,0-2.026-0.551L2.28,18.675c-0.57-0.329-0.922-0.945-0.922-1.604V6.921 c0-0.659,0.353-1.275,0.922-1.603l8.795-5.082c0.557-0.315,1.296-0.315,1.848,0l8.794,5.082c0.57,0.329,0.924,0.944,0.924,1.603 v10.15c0,0.659-0.354,1.273-0.924,1.604l-8.794,5.078C12.643,23.916,12.324,24,11.998,24z M19.099,13.993 c0-1.9-1.284-2.406-3.987-2.763c-2.731-0.361-3.009-0.548-3.009-1.187c0-0.528,0.235-1.233,2.258-1.233 c1.807,0,2.473,0.389,2.747,1.607c0.024,0.115,0.129,0.199,0.247,0.199h1.141c0.071,0,0.138-0.031,0.186-0.081 c0.048-0.054,0.074-0.123,0.067-0.196c-0.177-2.098-1.571-3.076-4.388-3.076c-2.508,0-4.004,1.058-4.004,2.833 c0,1.925,1.488,2.457,3.895,2.695c2.88,0.282,3.103,0.703,3.103,1.269c0,0.983-0.789,1.402-2.642,1.402 c-2.327,0-2.839-0.584-3.011-1.742c-0.02-0.124-0.126-0.215-0.253-0.215h-1.137c-0.141,0-0.254,0.112-0.254,0.253 c0,1.482,0.806,3.248,4.655,3.248C17.501,17.007,19.099,15.91,19.099,13.993z"/></svg><span>Node.js</span>
        </a>
        <a class="chip" style="--accent:#3178C6" href="https://www.typescriptlang.org" target="_blank" rel="noreferrer noopener">
          <svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.104.156.252.304.443.444s.423.276.696.41c.273.135.582.274.926.416.47.197.892.407 1.266.628.374.222.695.473.963.753.268.279.472.598.614.957.142.359.214.776.214 1.253 0 .657-.125 1.21-.373 1.656a3.033 3.033 0 0 1-1.012 1.085 4.38 4.38 0 0 1-1.487.596c-.566.12-1.163.18-1.79.18a9.916 9.916 0 0 1-1.84-.164 5.544 5.544 0 0 1-1.512-.493v-2.63a5.033 5.033 0 0 0 3.237 1.2c.333 0 .624-.03.872-.09.249-.06.456-.144.623-.25.166-.108.29-.234.373-.38a1.023 1.023 0 0 0-.074-1.089 2.12 2.12 0 0 0-.537-.5 5.597 5.597 0 0 0-.807-.444 27.72 27.72 0 0 0-1.007-.436c-.918-.383-1.602-.852-2.053-1.405-.45-.553-.676-1.222-.676-2.005 0-.614.123-1.141.369-1.582.246-.441.58-.804 1.004-1.089a4.494 4.494 0 0 1 1.47-.629 7.536 7.536 0 0 1 1.77-.201zm-15.113.188h9.563v2.166H9.506v9.646H6.789v-9.646H3.375z"/></svg><span>TypeScript</span>
        </a>
        <a class="chip" style="--accent:#646CFF" href="https://vite.dev" target="_blank" rel="noreferrer noopener">
          <svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.056 23.238a.57.57 0 0 1-1.02-.355v-5.202c0-.63-.512-1.143-1.144-1.143H5.148a.57.57 0 0 1-.464-.903l3.777-5.29c.54-.753 0-1.804-.93-1.804H.57a.574.574 0 0 1-.543-.746.6.6 0 0 1 .08-.157L5.008.78a.57.57 0 0 1 .467-.24h14.589a.57.57 0 0 1 .466.903l-3.778 5.29c-.54.755 0 1.806.93 1.806h5.745c.238 0 .424.138.513.322a.56.56 0 0 1-.063.603z"/></svg><span>Vite</span>
        </a>
        <a class="chip" style="--accent:#EC4A3F" href="https://rollupjs.org" target="_blank" rel="noreferrer noopener">
          <svg class="vlogo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.42.0002a.37.37 0 00-.369.37V19.885c.577-1.488 1.557-3.6168 3.1378-6.5297C11.8885 2.876 12.6355 1.8191 15.6043 1.8191c1.56 0 3.1338.704 4.1518 1.9549A7.9616 7.9616 0 0013.1014.0002zM16.1393 2.544c-1.19.01-2.257.466-2.6979 1.498-.967 2.2558 1.624 4.7667 2.7569 4.5677 1.4419-.255-.255-3.5628-.255-3.5628 2.2049 4.1558 1.6969 2.8838-2.2899 6.6996C9.6666 15.5623 5.596 23.6188 5.002 23.9568a.477.477 0 01-.08.043H20.558a.373.373 0 00.33-.538l-4.0878-8.0915a.37.37 0 01.144-.488 7.9596 7.9596 0 004.0048-6.9126c0-1.4249-.373-2.7608-1.03-3.9198-.9269-.9519-2.4298-1.5159-3.7787-1.5059z"/></svg><span>Rollup</span>
        </a>
        <a class="chip" style="--accent:#c4b04f" href="https://eta.js.org" target="_blank" rel="noreferrer noopener">
          <span>Eta</span>
        </a>
      </nav>

      <footer>
        Propulsé par <a href="https://nodefony.net" target="_blank" rel="noreferrer noopener">nodefony.net</a>
      </footer>
    </main>

    <!-- Debug bar Nodefony — bundle standalone AUTO-MONTANT servi par
         /app/debugbar.js (script EXTERNE → passe la CSP script-src 'self'). -->
    <script type="module" src="/app/debugbar.js"></script>
  </body>
</html>
