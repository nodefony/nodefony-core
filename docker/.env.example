# Nodefony — infra dev. Copier en `docker/.env` puis adapter.
#   cp docker/.env.example docker/.env
# `docker/.env` est ignoré par git (secrets) — ne jamais committer de vrai mot de passe.

# Redis (Bloc B)
REDIS_PASSWORD=nodefony-dev
REDIS_PORT=6379

# RedisInsight (profile tools)
REDISINSIGHT_PORT=5540

# Kafka (profile kafka — Bloc C)
KAFKA_PORT=9092
