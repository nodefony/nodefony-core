{
  "realm": "nodefony",
  "displayName": "Nodefony SSO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "loginTheme": "nodefony",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "nodefony-dev",
      "name": "Nodefony Studio (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "nodefony-dev-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:5152/nodefony/security/api/oauth2/keycloak/callback",
        "http://localhost:5151/nodefony/security/api/oauth2/keycloak/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5152/*##http://localhost:5151/*"
      },
      "protocolMappers": [
        {
          "name": "audience-nodefony-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://localhost:5152/nodefony/test/keycloak",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "description": "Console d'administration du framework Nodefony — supervision, sécurité et données, en développement."
    },
    {
      "clientId": "nodefony-machine",
      "name": "Nodefony — appelant machine (compte de service)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "nodefony-machine-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-nodefony-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://localhost:5152/nodefony/test/keycloak",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "description": "Appelant machine (compte de service) : obtient un jeton d'accès par client_credentials, sans utilisateur."
    }
  ],
  "users": [
    {
      "id": "e5d1ca21-4a48-4e0a-9949-32f91c7b5b98",
      "username": "alice",
      "enabled": true,
      "email": "alice@nodefony.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Keycloak",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev",
          "temporary": false
        }
      ]
    }
  ],
  "rememberMe": true
}
