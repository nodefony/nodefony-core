{
  "realm": "nodefony",
  "displayName": "Nodefony SSO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "loginTheme": "nodefony",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "nodefony-dev",
      "name": "Nodefony Studio (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "nodefony-dev-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:5152/nodefony/security/api/oauth2/keycloak/callback",
        "http://localhost:5151/nodefony/security/api/oauth2/keycloak/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5152/*##http://localhost:5151/*",
        "backchannel.logout.url": "http://host.docker.internal:5151/nodefony/security/api/oauth2/keycloak/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-nodefony-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://localhost:5152/nodefony/test/keycloak",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "description": "Console d'administration du framework Nodefony — supervision, sécurité et données, en développement."
    },
    {
      "clientId": "nodefony-machine",
      "name": "Nodefony — appelant machine (compte de service)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "nodefony-machine-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-nodefony-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://localhost:5152/nodefony/test/keycloak",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "description": "Appelant machine (compte de service) : obtient un jeton d'accès par client_credentials, sans utilisateur."
    }
  ],
  "roles": {
    "client": {
      "nodefony-dev": [
        {
          "name": "admin",
          "description": "Administrateur de l'application — traduit en ROLE_ADMIN par la table roleMapping du fournisseur keycloak."
        },
        {
          "name": "admin-nodefony",
          "description": "Administrateur de la PLATEFORME — traduit en ROLE_NODEFONY_ADMIN, ouvert par allowPlatformRoles dans la config de l'app de dev."
        }
      ]
    }
  },
  "users": [
    {
      "id": "e5d1ca21-4a48-4e0a-9949-32f91c7b5b98",
      "username": "alice",
      "enabled": true,
      "email": "alice@nodefony.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Keycloak",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev",
          "temporary": false
        }
      ]
    },
    {
      "id": "7c0f3b52-9d1e-4a6b-8f2a-3e5c1d9b7a40",
      "username": "bob",
      "enabled": true,
      "email": "bob@nodefony.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Keycloak",
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "nodefony-dev": ["admin"]
      }
    },
    {
      "id": "3b8e6f14-2c7a-4d95-b1e0-9f4a6c2d8e71",
      "username": "cci",
      "enabled": true,
      "email": "cci@nodefony.test",
      "emailVerified": true,
      "firstName": "Cci",
      "lastName": "Keycloak",
      "credentials": [
        {
          "type": "password",
          "value": "cci-dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "nodefony-dev": ["admin", "admin-nodefony"]
      }
    }
  ],
  "rememberMe": true
}
