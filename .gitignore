# Ignore les fichiers de configuration spécifiques à l'IDE
.vscode/
.idea/

# Agents de développement : leur dossier est le home REDIRIGÉ que `ai:mcp` leur
# donne pour que la porte MCP soit déclarée par PROJET (son URL porte un port —
# une déclaration globale ne pourrait désigner qu'une application). Ils y
# déposent aussi leurs fichiers de travail : seule la DÉCLARATION se versionne.
.vibe/*
!.vibe/config.toml
.codex/*
!.codex/config.toml

# Ignore les fichiers de sauvegarde automatique et les fichiers de build
*.bak
*.log
*.turbo
# Traces d'un banc qui lance un vrai serveur : pid du process et rapports machine
# des passes ciblées, lus pour vérifier que les cas visés ont RÉELLEMENT tourné.
# Écrits par la CI comme en local, jamais versionnés.
*.pid
*-report.json
dist/
node_modules/
tmp/
# Sites RENDUS (`build-docs-site.mjs`, `build-perf-site.mjs`) : ~12 Mo de HTML
# dérivé, reconstruit à l'identique depuis le Markdown et les mesures versionnés.
# La SOURCE est ce Markdown ; le rendu ne vit que dans l'artefact publié sur
# Pages. `dist/` ne les couvrait pas — un `git add -A` après un build local les
# aurait emportés dans un commit, sans que rien ne le signale.
dist-site/
dist-perf-site/
# Support de présentation GÉNÉRÉ (`node scripts/readme-html.mjs`) : ~1 Mo dont
# des captures en base64, réécrit intégralement à chaque exécution. La source
# versionnée est le script ; committer sa sortie alourdirait chaque diff sans
# rien apprendre à personne.
/readme.html
# ANCRÉ (`/logs/`, pas `logs/`) : un motif non ancré vaut pour TOUT dossier nommé
# `logs`, à n'importe quelle profondeur — il masquait `studio/frontend/src/routes/
# logs/` (les composants de la page Logs). Un `git add <dossier>` saute un chemin
# ignoré SANS RIEN DIRE : un nouveau composant y serait resté hors de tout commit.
# Ici on ne vise que les logs runtime écrits à la racine du repo.
/logs/
# Données runtime persistées (store fichier WebAuthn, etc.) — JAMAIS commitées.
var/
# Certificats TLS générés — JAMAIS commités (contiennent la clé privée). Motif
# **/ pour couvrir aussi les sous-modules : le service écrit dans
# <cwd>/nodefony/config/certificates → dossier du module si tests/CLI lancés là.
**/nodefony/config/certificates/
nodefony/databases/*

# Ignore les fichiers générés par TypeScript
*.tsbuildinfo
*.js.map

# Rapports de couverture — les DEUX emplacements. Les modules ne sont pas
# configurés pareil (`reportsDirectory` vaut `.coverage` chez les uns, le
# défaut `coverage` chez les autres) et `npm run coverage` les fait tous
# tourner : n'en ignorer qu'un laisse 41 fichiers de rapport entrer dans le
# dépôt. Un rapport est une PHOTO, il se refabrique.
.coverage/
coverage/

# Fichiers d'environnement — Convention B (Vite/Next).
#   Committés (défauts NON-secrets) : .env, .env.<env>, .env.example
#   Gitignorés (secrets / machine)  : *.local → .env.local, .env.<env>.local
# Précédence (cf src/nodefony/src/runtime/loadEnv.ts) : les *.local priment.
*.local

# Secrets posés chez les agents de développement (nodefony security:token --write).
# 🔴 `.gemini/.env` porte un JETON PORTEUR : la déclaration de la porte MCP,
# elle, reste versionnable (.gemini/settings.json, .mcp.json) — c'est la CLÉ qui
# ne se commite pas. Un jeton commité est un jeton publié.
.gemini/.env
.gemini/.env.*

# Ignore les fichiers de sauvegarde
*.swp
*.swo

# Artefacts runtime locaux de Claude Code (verrou du planificateur de tâches, etc.)
# — les skills/settings de .claude/ restent versionnés, on n'ignore que les locks.
.claude/*.lock

# Ignore les fichiers système et cachés
.DS_Store
Thumbs.db
ehthumbs.db

# Ignore les fichiers d'exemple ou temporaires
example/
temp/

# Fixture Dolibarr — schéma GPLv3 dérivé (local only, ne pas committer dans un repo CeCILL-B).
# ⚠️ Un dossier ignoré est ABSENT de tout clone : aucun fichier versionné ne doit
# l'importer, sous peine de rendre le dépôt public inconstruisible (vécu — la CI a
# passé deux mois rouge sur un `import` de ce chemin). Idem pour tout artefact
# généré puis commité, qui doit l'exclure de son scan (cf generate-symbols.config).
src/modules/test/nodefony/entity/dolibarr/

# Un seul gestionnaire fait foi (packageManager: npm) — un lock étranger commité
# divergerait en silence du package-lock.json testé. bun.lock = format texte bun ≥ 1.2.
yarn.lock
bun.lockb
bun.lock
pnpm-lock.yaml

# Discussions de travail (décisions captées dans MIGRATION_STATUS + mémoire IA)
analyse.txt
realtime.txt
*.discussion.txt
vite.config.generated.mjs
/release/

# Graphe symbolique publie par le paquet nodefony — GENERE (npm run generate-symbols),
# comme dist/ : il part dans le tarball, il ne se versionne pas (le .ai/ RACINE, lui, est commite).
src/nodefony/.ai/
