# Ignore les fichiers de configuration spécifiques à l'IDE
.vscode/
.idea/

# Ignore les fichiers de sauvegarde automatique et les fichiers de build
*.bak
*.log
*.turbo
dist/
node_modules/
tmp/
# Support de présentation GÉNÉRÉ (`node scripts/readme-html.mjs`) : ~1 Mo dont
# des captures en base64, réécrit intégralement à chaque exécution. La source
# versionnée est le script ; committer sa sortie alourdirait chaque diff sans
# rien apprendre à personne.
/readme.html
# ANCRÉ (`/logs/`, pas `logs/`) : un motif non ancré vaut pour TOUT dossier nommé
# `logs`, à n'importe quelle profondeur — il masquait `studio/frontend/src/routes/
# logs/` (les composants de la page Logs). Un `git add <dossier>` saute un chemin
# ignoré SANS RIEN DIRE : un nouveau composant y serait resté hors de tout commit.
# Ici on ne vise que les logs runtime écrits à la racine du repo.
/logs/
# Données runtime persistées (store fichier WebAuthn, etc.) — JAMAIS commitées.
var/
# Certificats TLS générés — JAMAIS commités (contiennent la clé privée). Motif
# **/ pour couvrir aussi les sous-modules : le service écrit dans
# <cwd>/nodefony/config/certificates → dossier du module si tests/CLI lancés là.
**/nodefony/config/certificates/
nodefony/databases/*

# Ignore les fichiers générés par TypeScript
*.tsbuildinfo
*.js.map

# Rapports de couverture monocart-coverage-reports (tous modules)
.coverage/

# Fichiers d'environnement — Convention B (Vite/Next).
#   Committés (défauts NON-secrets) : .env, .env.<env>, .env.example
#   Gitignorés (secrets / machine)  : *.local → .env.local, .env.<env>.local
# Précédence (cf src/nodefony/src/runtime/loadEnv.ts) : les *.local priment.
*.local

# Ignore les fichiers de sauvegarde
*.swp
*.swo

# Artefacts runtime locaux de Claude Code (verrou du planificateur de tâches, etc.)
# — les skills/settings de .claude/ restent versionnés, on n'ignore que les locks.
.claude/*.lock

# Ignore les fichiers système et cachés
.DS_Store
Thumbs.db
ehthumbs.db

# Ignore les fichiers d'exemple ou temporaires
example/
temp/

# Fixture Dolibarr — schéma GPLv3 dérivé (local only, ne pas committer dans un repo CeCILL-B).
# ⚠️ Un dossier ignoré est ABSENT de tout clone : aucun fichier versionné ne doit
# l'importer, sous peine de rendre le dépôt public inconstruisible (vécu — la CI a
# passé deux mois rouge sur un `import` de ce chemin). Idem pour tout artefact
# généré puis commité, qui doit l'exclure de son scan (cf generate-symbols.config).
src/modules/test/nodefony/entity/dolibarr/

yarn.lock
bun.lockb

# Discussions de travail (décisions captées dans MIGRATION_STATUS + mémoire IA)
analyse.txt
realtime.txt
*.discussion.txt
vite.config.generated.mjs
/release/
