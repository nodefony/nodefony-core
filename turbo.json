{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.gates.ts", "vitest.oxc.ts", "vitest.perf.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/nodefony"],
      "inputs": [
        "index.ts",
        "src/**",
        "nodefony/**",
        "rolldown.config.ts",
        "vite.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "index.ts",
        "src/**",
        "nodefony/**",
        "tests/**",
        "vitest*.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "test:load": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "test:memory": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "test:boot": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "test:cluster": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_URL", "DATABASE_URL", "MONGODB_URI", "CI"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "inputs": ["index.ts", "src/**", "nodefony/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["index.ts", "src/**", "nodefony/**", "tsconfig*.json"]
    },

    // Le CŒUR ne lit AUCUNE source de module : il ne nomme aucun type de
    // `@nodefony/http` ni de `@nodefony/framework` — ce qu'il en attend est un
    // contrat qu'il définit lui-même (`IServerKernel`), que les modules étendent.
    // Ses `inputs` se bornent donc à son propre dossier. Réintroduire un
    // `import type` d'un module dans le cœur lui ferait recompiler ces sources
    // SANS que turbo le sache : cache servi sur du code jamais recompilé, le faux
    // vert qui avait passé le `pre-push` (erreur TS4114 dans `@nodefony/security`).
    // Contrôle : `npx tsgo -p src/nodefony --noEmit --listFiles` ne doit lister
    // aucun `src/packages/@nodefony/*` hors `dist`.
    "nodefony#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/nodefony"],
      "inputs": [
        "index.ts",
        "src/**",
        "nodefony/**",
        "rolldown.config.ts",
        "vite.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "nodefony#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["index.ts", "src/**", "nodefony/**", "tsconfig*.json"]
    }
  }
}
