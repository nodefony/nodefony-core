{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.gates.ts", "vitest.oxc.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/nodefony"],
      "inputs": [
        "index.ts",
        "src/**",
        "nodefony/**",
        "rolldown.config.ts",
        "vite.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "index.ts",
        "src/**",
        "nodefony/**",
        "tests/**",
        "vitest*.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "env": ["NF_*", "REDIS_*", "MONGO_TEST_URI", "MONGODB_URI", "RUN_*", "CI"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_*", "MONGO_TEST_URI", "MONGODB_URI", "RUN_*", "CI"]
    },
    "test:load": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_*", "MONGO_TEST_URI", "MONGODB_URI", "RUN_*", "CI"]
    },
    "test:memory": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_*", "MONGO_TEST_URI", "MONGODB_URI", "RUN_*", "CI"]
    },
    "test:boot": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["NF_*", "REDIS_*", "MONGO_TEST_URI", "MONGODB_URI", "RUN_*", "CI"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "inputs": ["index.ts", "src/**", "nodefony/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["index.ts", "src/**", "nodefony/**", "tsconfig*.json"]
    }
  }
}
