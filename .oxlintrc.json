{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "import"],
  // Règles TYPÉES (paquet `oxlint-tsgolint`) : elles lisent les types du
  // compilateur, là où les autres ne voient que la syntaxe. Et une directive
  // de désactivation qui ne couvre plus rien est signalée — sans quoi elle
  // survit au code qu'elle excusait et masque la suivante.
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.coverage/**",
    "**/bin/**",
    ".ai/**",
    "**/*.generated.*",
    "src/**/frontend/dist/**",
    "src/nodefony/src/tests/finder/data/**",
    "tmp/**",
    "examples/**/dist/**",
    // Copies FIGÉES de normes (spec MCP…) : le skill mesure leur dérive par
    // rapport à l'amont, on ne les corrige donc pas.
    ".claude/skills/nodefony-rfc/references/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          // UN SEUL fichier du dépôt connaît TanStack Table, et c'est ce qui rend
          // ses montées de version majeures abordables : la v9 (sortie le
          // 2026-08-04, après quatre-vingts betas) est une réécriture d'API, et
          // elle ne touchera qu'un fichier tant que cette garde tient. Le jour où
          // un écran importe `useReactTable` en direct, ce coût se multiplie par
          // le nombre d'écrans — silencieusement, puisque rien ne casse sur le
          // moment. La garde n'est donc pas stylistique : elle protège la
          // prochaine migration. Dérogation dans `overrides`, pour DataGrid seul.
          {
            "name": "@tanstack/react-table",
            "message": "Passe par le composant DataGrid (components/ui/DataGrid.tsx) — il est le SEUL point de contact du dépôt avec TanStack Table, et c'est ce qui garde ses montées de version majeures à un seul fichier. Un besoin non couvert par DataGrid s'ajoute À DataGrid."
          },
          {
            "name": "assert",
            "message": "Préfixe Node obligatoire : importe \"node:assert\"."
          },
          {
            "name": "buffer",
            "message": "Préfixe Node obligatoire : importe \"node:buffer\"."
          },
          {
            "name": "child_process",
            "message": "Préfixe Node obligatoire : importe \"node:child_process\"."
          },
          {
            "name": "cluster",
            "message": "Préfixe Node obligatoire : importe \"node:cluster\"."
          },
          {
            "name": "crypto",
            "message": "Préfixe Node obligatoire : importe \"node:crypto\"."
          },
          {
            "name": "dns",
            "message": "Préfixe Node obligatoire : importe \"node:dns\"."
          },
          {
            "name": "events",
            "message": "Préfixe Node obligatoire : importe \"node:events\"."
          },
          {
            "name": "fs",
            "message": "Préfixe Node obligatoire : importe \"node:fs\"."
          },
          {
            "name": "fs/promises",
            "message": "Préfixe Node obligatoire : importe \"node:fs/promises\"."
          },
          {
            "name": "http",
            "message": "Préfixe Node obligatoire : importe \"node:http\"."
          },
          {
            "name": "http2",
            "message": "Préfixe Node obligatoire : importe \"node:http2\"."
          },
          {
            "name": "https",
            "message": "Préfixe Node obligatoire : importe \"node:https\"."
          },
          {
            "name": "net",
            "message": "Préfixe Node obligatoire : importe \"node:net\"."
          },
          {
            "name": "os",
            "message": "Préfixe Node obligatoire : importe \"node:os\"."
          },
          {
            "name": "path",
            "message": "Préfixe Node obligatoire : importe \"node:path\"."
          },
          {
            "name": "perf_hooks",
            "message": "Préfixe Node obligatoire : importe \"node:perf_hooks\"."
          },
          {
            "name": "process",
            "message": "Préfixe Node obligatoire : importe \"node:process\"."
          },
          {
            "name": "querystring",
            "message": "Préfixe Node obligatoire : importe \"node:querystring\"."
          },
          {
            "name": "readline",
            "message": "Préfixe Node obligatoire : importe \"node:readline\"."
          },
          {
            "name": "stream",
            "message": "Préfixe Node obligatoire : importe \"node:stream\"."
          },
          {
            "name": "string_decoder",
            "message": "Préfixe Node obligatoire : importe \"node:string_decoder\"."
          },
          {
            "name": "timers",
            "message": "Préfixe Node obligatoire : importe \"node:timers\"."
          },
          {
            "name": "tls",
            "message": "Préfixe Node obligatoire : importe \"node:tls\"."
          },
          {
            "name": "url",
            "message": "Préfixe Node obligatoire : importe \"node:url\"."
          },
          {
            "name": "util",
            "message": "Préfixe Node obligatoire : importe \"node:util\"."
          },
          {
            "name": "v8",
            "message": "Préfixe Node obligatoire : importe \"node:v8\"."
          },
          {
            "name": "vm",
            "message": "Préfixe Node obligatoire : importe \"node:vm\"."
          },
          {
            "name": "worker_threads",
            "message": "Préfixe Node obligatoire : importe \"node:worker_threads\"."
          },
          {
            "name": "zlib",
            "message": "Préfixe Node obligatoire : importe \"node:zlib\"."
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/ban-ts-comment": "warn",
    // Le projet est ESM STRICT (`import`, jamais `require`) : la règle a
    // trouvé son unique transgression le jour de son activation, dans un
    // test — c'est exactement ce qu'une garde doit faire.
    "typescript/no-require-imports": "warn",
    // Préréglage `strict-type-checked` de typescript-eslint (norme de
    // référence) : un `any` ne se propage pas en silence — le lire, l'appeler,
    // l'affecter ou le rendre exige de l'avoir d'abord rétréci. Et `x!` affirme
    // au compilateur une absence de `null` qu'il ne peut pas vérifier.
    // Les paquets pas encore conformes sont listés dans l'override « cliquet »
    // plus bas : on y RETIRE une ligne quand un paquet est propre, on n'y en
    // ajoute jamais.
    // Règles TYPÉES du préréglage `strict-type-checked` qui n'étaient pas
    // allumées (les catégories d'oxlint ne les couvrent pas), plus
    // `switch-exhaustiveness-check` : celles qui attrapent des DÉFAUTS —
    // callback async passé là où l'on attend du synchrone, `return` sans
    // `await` dans un `try` qui saute le `catch`, rejet ou throw d'autre chose
    // qu'une `Error`, `case` oublié quand une union grandit. Mesure et suite
    // du durcissement : #498.
    "typescript/no-misused-promises": "error",
    "typescript/return-await": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/only-throw-error": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // `a && a.b` → `a?.b` : plus court, et une seule lecture de `a`. Le
    // correctif automatique N'EST PAS sûr : il a retiré une garde
    // `typeof window` (le type DOM déclare `window` toujours présent) et, dans
    // un `.mjs` sans types, fondu `x === null || x === undefined` en
    // `=== undefined`. Hors condition, `a && a.b` rend `a` (`""`, `0`, `null`)
    // là où `a?.b` rend `undefined` : relire chaque site, jamais `--fix` en masse.
    "typescript/prefer-optional-chain": "error",
    // `??` là où l'on voulait « absent » et où `||` avalait aussi `""`/`0`.
    // PRIMITIFS EXCLUS, et c'est une décision, pas une facilité : sur une
    // chaîne, un nombre ou un booléen, `||` est ICI l'idiome voulu — une
    // variable d'environnement posée vide vaut « absente », un id de session
    // `""` doit en générer un (`??` l'accepterait), `cmp() || suivant` chaîne
    // les critères d'un tri, `a || b` entre booléens est un OU logique. Les
    // 324 sites ont été relus : quatre défauts réels corrigés à la main
    // (`q=0` d'`Accept` relevé à 1, sévérité syslog 0 = EMERGENCY avalée,
    // `F_OK` = 0 écrasé, compte ORM 0 affiché « — »), aucun autre.
    // Sur un objet, un tableau ou une fonction, la règle mord pleinement.
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true,
          "number": true,
          "boolean": true,
          "bigint": true
        }
      }
    ],
    // Une expression `void` là où l'on attend une valeur. Mesurée : 1 343 sites,
    // dont 1 158 flèches courtes `() => fnVoid()` et une majorité de
    // `return resolve(x)` dans des fonctions `void` — deux idiomes lisibles
    // qui ne cachent rien, d'où les deux exemptions. Ce qui RESTE mord sur le
    // vrai défaut : une fonction au type de retour INFÉRÉ qui mêle une valeur
    // et un `return fnVoid()` — l'appelant, et le `.d.ts` publié, voient
    // `X | void`. Coupée dans les tests et les scripts (cf overrides).
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true, "ignoreVoidReturningFunctions": true }
    ],
    // `describe`/`it`/`test` de `node:test` rendent une promesse que le RUNNER
    // suit lui-même (la doc Node dit de l'ignorer) : déclaré sûr ICI, une fois,
    // plutôt que par une dérogation dans chaque fichier de test.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["describe", "it", "test", "suite"]
          }
        ]
      }
    ],
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-non-null-assertion": "warn",
    // Allumées par `typeAware` via les catégories, mais ABSENTES du préréglage
    // `strict-type-checked` : coupées exprès. `no-unsafe-type-assertion`
    // interdit tout `as` qui rétrécit (1 781 sites, dont les rétrécissements
    // légitimes après validation) ; `consistent-return` double le
    // `noImplicitReturns` du compilateur ; `require-array-sort-compare` refuse
    // un `sort()` de chaînes, correct par défaut.
    "typescript/no-unsafe-type-assertion": "off",
    "consistent-return": "off",
    "typescript/require-array-sort-compare": "off",
    // `async` sans `await` : 557 sites mesurés (#498), tous des IMPLÉMENTATIONS
    // d'un contrat qui rend une `Promise` — hooks de module, `init()`,
    // `generate()`, stores mémoire, transports, callbacks de test. Là, `async`
    // est le geste JUSTE : il convertit toute exception du corps en REJET.
    // Le retirer change le contrat (`assertPageQuery` de
    // `MemoryWebhookStore.listPage` lèverait en SYNCHRONE, hors du `.catch()` de
    // l'appelant) ; le remplacer par `Promise.resolve(x)` ajoute du bruit sans
    // rien protéger. Le défaut qu'elle visait — une promesse oubliée — est déjà
    // attrapé par `no-floating-promises` et `no-misused-promises`.
    "typescript/require-await": "off",
    "no-console": "off",
    "no-eval": "error",
    "no-new-func": "error",
    "typescript/no-empty-object-type": "off",
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "typescript/no-extraneous-class": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "no-await-in-loop": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-new-array": "off",
    "no-control-regex": "off",
    "typescript/no-this-alias": "off",
    // Le DERNIER maillon d'une chaîne n'a personne à qui transmettre : il pose un
    // drapeau, journalise, résout une promesse englobante. Exiger un `return` là
    // ne protège de rien. Sur un maillon INTERMÉDIAIRE, en revanche, l'oubli est
    // un vrai défaut — le maillon suivant reçoit `undefined` — et la règle le dit
    // toujours.
    "promise/always-return": ["warn", { "ignoreLastCallback": true }],
    // MAINTENUE en production, désactivée dans les tests et les scripts (cf
    // overrides). Elle a trouvé le seul défaut qu'on ne voyait pas : un
    // `child_process` dont le lancement échoue émet `error` PUIS `close` — deux
    // verdicts pour une seule promesse, le second écrasant le premier en silence
    // (cf `docsReader.ts`, garde `settle`). Ce piège reviendra, et c'est ELLE qui
    // le dira.
    //
    // Prix à payer, assumé : elle compte les `resolve`/`reject` d'une portée sans
    // suivre le flux, donc elle signale aussi des formes correctes — un
    // `return resolve()`, un ternaire `c ? resolve() : reject()`, une garde
    // d'idempotence (`if (settled) return`), et la course volontaire d'une sonde
    // où le premier arrivé gagne (`end` / `error` / `timeout`). Cinq signalements
    // permanents, tous vérifiés un par un. Les laisser visibles coûte moins cher
    // que de perdre le seul cas qui mord.
    "promise/no-multiple-resolved": "warn"
  },
  "overrides": [
    {
      // Le point de contact UNIQUE avec TanStack Table — la seule dérogation à la
      // garde posée plus haut. `off` en entier plutôt qu'une liste réduite : la
      // redonner amputée d'une entrée recopierait les vingt règles `node:` juste
      // à côté de leur original, et deux listes divergent toujours. Un composant
      // React n'a de toute façon aucun module Node à importer.
      "files": ["**/components/ui/DataGrid.tsx"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // CLIQUET de `no-unnecessary-condition` (#498) : la règle mord sur ce qui
      // a été relu, et la liste ne fait que grandir jusqu'à couvrir le dépôt —
      // la règle passe alors dans `rules`, et au gabarit d'application.
      // Chaque site se JUGE, il ne se corrige pas en masse : une garde sur une
      // donnée venue du réseau, du disque, d'une config non validée ou d'un
      // appelant JavaScript est légitime — c'est alors le TYPE qu'on rend
      // honnête (`| undefined`, `Partial`, `unknown`), pas la garde qu'on retire.
      // Placée AVANT la surcharge des tests, qui la coupe pour eux.
      "files": ["src/nodefony/src/**", "src/packages/@nodefony/orm-core/**"],
      "rules": {
        "typescript/no-unnecessary-condition": "error"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/tests/**/*.ts",
        "**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "scripts/**/*.ts",
        ".claude/skills/**/scripts/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        // Un test garde ce que le type promet pour le PROUVER : la garde y est
        // l'assertion. Le cliquet #498 ne porte que sur la production.
        "typescript/no-unnecessary-condition": "off",
        "no-unused-expressions": "off",
        "no-unused-vars": "off",
        "no-console": "off",
        "no-restricted-imports": "off",
        // `new Foo()` dont on jette le résultat : en production c'est le signe
        // d'une intention perdue, dans un test c'est le test lui-même. Les trois
        // motifs rencontrés ici — construire pour OBSERVER l'effet de bord du
        // constructeur (un `Module` qui pose ses écouteurs kernel, l'assertion
        // suit), un banc de perf (« 100 constructions < 500 ms »), et une
        // construction sous `assert.doesNotThrow` / `assert.throws`. Le résultat
        // n'a nulle part où aller ; le stocker créerait une variable jamais lue.
        // Vérifié avant de déroger : 37 occurrences, 37 en tests, 0 en production.
        "no-new": "off",
        // Un `it()` rend sa chaîne d'assertions au runner, qui en ignore la
        // valeur. Exiger un `return` à la fin d'un test ne décrit rien.
        "promise/always-return": "off",
        // Reste ACTIVE en production (cf rules) : c'est là qu'elle a trouvé un
        // vrai double verdict. Ici elle n'a signalé que des décors — sondes
        // tolérantes où le premier arrivé gagne, gardes `settled` explicites.
        "promise/no-multiple-resolved": "off",
        // Reste ACTIVE en production, et pour cause : c'est là qu'elle a trouvé
        // six variables locales qui masquaient un IMPORT du même nom — un `path`
        // qui cachait `node:path` utilisé soixante lignes plus bas, un `sql` qui
        // cachait le gabarit de drizzle. Aucune ne cassait quoi que ce soit ce
        // jour-là ; toutes cassaient la ligne suivante écrite dans la portée.
        // Dans un banc, en revanche, réutiliser `i`, `r` ou `results` dans une
        // portée interne est l'idiome même du test, et le test est son propre
        // filet. Vérifié avant de déroger : 56 occurrences, 41 ici, 15 en
        // production — ces quinze-là ont été renommées, pas dérogées.
        "no-shadow": "off",
        // Un double de test manipule des formes partielles et des valeurs
        // qu'il vient de construire : `any` y est déjà autorisé (plus haut),
        // ses propagations et les `x!` sur un décor connu le sont aussi.
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-non-null-assertion": "off",
        // `expect(mock.fn).toHaveBeenCalled()` référence une méthode sans la
        // lier : c'est l'idiome du runner, pas un `this` perdu (typescript-eslint
        // renvoie les tests à la variante du runner). Et un test de parité
        // construit exprès une fonction depuis une source (`new Function`).
        "typescript/unbound-method": "off",
        "typescript/no-implied-eval": "off",
        // `return repondre(res, 404, …)` : sortie anticipée d'un faux serveur
        // de banc, sans type de retour déclaré. Aucun appelant n'en lit la
        // valeur, et l'`.mjs` n'a pas de `.d.ts` à protéger.
        "typescript/no-confusing-void-expression": "off"
      }
    },
    {
      // JavaScript non typé : tout y est `any` par nature, les règles qui
      // suivent la propagation d'un `any` n'y ont aucun sens.
      "files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    }
  ]
}
