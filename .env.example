# .env.example — MODÈLE d'onboarding (committé, 0 secret réel).
#
# ⚙️  GÉNÉRÉ depuis env.ts (catalogue defineEnv) — NE PAS éditer à la main.
#     Régénérer : npx tsx scripts/gen-env-example.ts
#
# Toutes les variables sont COMMENTÉES (le framework a des défauts) : décommenter
# celles que ton déploiement surcharge, dans .env.local (secrets/machine, gitignoré)
# ou .env / .env.<env> (défauts non-secrets). Précédence (cf
# src/nodefony/src/runtime/loadEnv.ts), du plus fort au plus faible :
#   process.env > .env.<appEnv>.local > .env.<env>.local > .env.local
#               > .env.<appEnv> > .env.<env> > .env
#
# Override GÉNÉRIQUE de config (hors catalogue) : NF__<MODULE|APP>__<CHEMIN>=valeur
#   ex. NF__APP__SERVERS__HTTP__PORT=8080  ·  NF__SECURITY__JWT__ACCESSTTLS=300
# Secret monté en conteneur : toute variable accepte aussi <NOM>_FILE (Docker/K8s).
#
# ─── Variables HORS catalogue typé (reconnues, non déclarées dans env.ts) ──────
# Mode runtime / déploiement (12-factor — posés par la commande `nodefony …` ou
# l'orchestrateur, PAS figés dans un fichier committé) :
#   NODE_ENV=production          # development | production (moteur runtime)
#   APP_ENV=staging              # env de DÉPLOIEMENT libre (alias : NODEFONY_ENV)
#   NODEFONY_WORKERS=auto        # nb de process cluster (CLI --workers > ceci)
# Module @nodefony/redis (lues par defineRedisConfig ; ou override NF__REDIS__*) :
#   REDIS_URL=redis://localhost:6379
#   REDIS_HOST=localhost
#   REDIS_PORT=6379
#   REDIS_PASSWORD=change-me     # → .env.local (secret, jamais committé)
#
# ─── Catalogue typé (env.ts) — généré ci-dessous ──────────────────────────────
#
# ─── Social login OAuth 2.0 ───────────────────────────────────────────────────
# Un fournisseur n'est monté QUE si SES deux secrets sont présents. Le callback
# enregistré chez le fournisseur doit être EXACTEMENT (RFC 9700) :
#   <OAUTH_REDIRECT_BASE>/nodefony/security/api/oauth2/<provider>/callback
# ⚠️ Défaut = https://localhost:5152 (PAS 127.0.0.1) : WebAuthn refuse une IP comme
#    rpId. Google : si https://localhost est refusé, utiliser http://localhost:5151.

# Infra database : URL unique (sqlite:|postgres://|mysql://|mongodb://), dialecte déduit du scheme.
#   (optionnel)
# NF_DATABASE_URL=

# Infra cache : URL Redis (redis://…) — sa présence charge @nodefony/redis.
#   (optionnel)
# NF_REDIS_URL=

# Sink d'écriture des logs : stdout | file | null.
#   (valeurs: stdout | file | null · défaut: stdout)
# NF_LOG_DRIVER=stdout

# Écriture synchrone du sink fichier (writeSync par worker).
#   (défaut: false)
# NF_LOG_FILE_SYNC=false

# Driver de relecture du log backplane (auto|memory|file|…).
#   (défaut: auto)
# NF_LOG_QUERY_DRIVER=auto

# URL HTTP de la destination Loki (poussée + relecture).
#   (optionnel)
# NF_LOKI_URL=

# URL HTTP de la destination OpenSearch (poussée + relecture).
#   (optionnel)
# NF_OPENSEARCH_URL=

# DEV : bind 0.0.0.0 + trustProxy (banc reverse-proxy Docker).
#   (défaut: false)
# NF_BIND_ALL=false

# OAuth Google — Client ID (Google Cloud Console).
#   (optionnel)
# GOOGLE_CLIENT_ID=

# OAuth Google — Client Secret (SECRET, jamais loggé).
#   (optionnel · secret → .env.local, jamais committé)
# GOOGLE_CLIENT_SECRET=

# OAuth GitHub — Client ID (Developer Settings › OAuth Apps).
#   (optionnel)
# GITHUB_CLIENT_ID=

# OAuth GitHub — Client Secret (SECRET, jamais loggé).
#   (optionnel · secret → .env.local, jamais committé)
# GITHUB_CLIENT_SECRET=

# Base d'URL des callbacks OAuth (exact match fournisseur).
#   (défaut: https://localhost:5152)
# OAUTH_REDIRECT_BASE=https://localhost:5152

# Dépôt du service users : auto (suit l'infra database) | drizzle | mongoose | memory (volatil).
#   (valeurs: auto | drizzle | mongoose | memory · défaut: auto)
# NF_USER_STORE=auto

#   (optionnel)
# NF_STORE=

# Cache d'idempotence : auto (suit l'infra déclarée) | memory (per-pod) | redis | drizzle (distribués cross-pod).
#   (valeurs: auto | memory | redis | drizzle · défaut: auto)
# NF_IDEMPOTENCY_STORE=auto

# Mot de passe de l'admin seedé (dev défaut 'secret' ; prod requis).
#   (optionnel · secret → .env.local, jamais committé)
# NF_ADMIN_PASSWORD=

# Mot de passe du compte de fixture 'user' (dev, défaut 'secret').
#   (optionnel · secret → .env.local, jamais committé)
# NF_USER_PASSWORD=

# Backend des endpoints webhook : auto (suit l'infra déclarée) | memory | drizzle (durable).
#   (valeurs: auto | memory | drizzle · défaut: auto)
# NF_WEBHOOK_STORE=auto

# Clé de chiffrement des secrets de signature webhook (prod requis).
#   (optionnel · secret → .env.local, jamais committé)
# NF_WEBHOOK_KEY=
