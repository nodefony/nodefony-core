# .env.example — la NOTICE des variables (commitée, jamais chargée, 0 secret).
#
# ⚙️  GÉNÉRÉ depuis env.ts (catalogue defineEnv) — NE PAS éditer à la main.
#     Régénérer : npx nodefony env --example
#     Vérifier  : npx nodefony env --example --check   (pre-commit, CI)
#
# Deux fichiers, une règle — « qui fournit la valeur ? » :
#   .env.example  → CE fichier : la notice, commitée, jamais lue au démarrage.
#   .env          → TES valeurs de poste, secrets de dev compris. JAMAIS commité.
#   production    → AUCUN fichier : secrets par l'orchestrateur ou le gestionnaire
#                   de secrets ; réglages non secrets dans nodefony.config.ts.
# Précédence : variable du process (shell, orchestrateur) > .env.
#
# Override GÉNÉRIQUE de config (hors catalogue) : NF__<MODULE|APP>__<CHEMIN>=valeur
#   ex. NF__APP__SERVERS__HTTP__PORT=8080
# Secret monté en conteneur : toute variable accepte aussi <NOM>_FILE (Docker/K8s).
#
# Lues par le framework, hors catalogue (posées par la commande ou l'orchestrateur) :
#   NODE_ENV=production   # development | production — posé par la commande nodefony …
#   APP_ENV=staging       # environnement de DÉPLOIEMENT libre (alias : NF_ENV)
#   NF_WORKERS=auto       # nombre de process du cluster (--workers l'emporte)

# Port d'écoute HTTP (défaut framework 5151).
#   (optionnel)
# NF_PORT=

# Alias plateforme du port HTTP (Cloud Run/Heroku) — NF_PORT gagne.
#   (optionnel)
# PORT=

# Port d'écoute HTTPS/HTTP2 (défaut framework 5152).
#   (optionnel)
# NF_PORT_HTTPS=

# Infra database : URL unique (sqlite:|postgres://|mysql://|mongodb://), dialecte déduit du scheme.
#   (optionnel)
# NF_DATABASE_URL=

# Infra cache : URL Redis (redis://…) — sa présence charge @nodefony/redis.
#   (optionnel)
# NF_REDIS_URL=

# Sink d'écriture des logs : stdout | file | null.
#   (valeurs: stdout | file | null · défaut: stdout)
# NF_LOG_DRIVER=stdout

# Écriture synchrone du sink fichier (writeSync par worker).
#   (défaut: false)
# NF_LOG_FILE_SYNC=false

# Driver de relecture du log backplane (auto|memory|file|…).
#   (défaut: auto)
# NF_LOG_QUERY_DRIVER=auto

# URL HTTP de la destination Loki (poussée + relecture).
#   (optionnel)
# NF_LOKI_URL=

# URL HTTP de la destination OpenSearch (poussée + relecture).
#   (optionnel)
# NF_OPENSEARCH_URL=

# DEV : bind 0.0.0.0 + trustProxy (banc reverse-proxy Docker).
#   (défaut: false)
# NF_BIND_ALL=false

# Livraison de l'UI Studio : auto (défaut) | static (pré-buildé, sans Vite) | vite.
#   (valeurs: auto | static | vite · défaut: auto)
# NF_STUDIO_UI=auto

# OAuth Google — Client ID (Google Cloud Console).
#   (optionnel)
# GOOGLE_CLIENT_ID=

# OAuth Google — Client Secret (SECRET, jamais loggé).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# GOOGLE_CLIENT_SECRET=

# OAuth GitHub — Client ID (Developer Settings › OAuth Apps).
#   (optionnel)
# GITHUB_CLIENT_ID=

# OAuth GitHub — Client Secret (SECRET, jamais loggé).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# GITHUB_CLIENT_SECRET=

# OIDC Keycloak — émetteur = URL du realm, en https (ex. https://localhost:8444/realms/nodefony).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_KEYCLOAK_ISSUER=

# OIDC Keycloak — identifiant du client confidentiel.
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_KEYCLOAK_CLIENT_ID=

# OIDC Keycloak — secret du client confidentiel (SECRET, jamais loggé).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_KEYCLOAK_CLIENT_SECRET=

# Base d'URL des callbacks OAuth. Un fournisseur n'est monté QUE si ses deux secrets sont posés.
# Callback à enregistrer chez lui, EXACTEMENT (RFC 9700) :
#   <NF_OAUTH_REDIRECT_BASE>/nodefony/security/api/oauth2/<provider>/callback
# ⚠️ localhost, PAS 127.0.0.1 : WebAuthn refuse une IP comme rpId.
# Google : si https://localhost est refusé, utiliser http://localhost:5151.
#   (défaut: https://localhost:5152)
# NF_OAUTH_REDIRECT_BASE=https://localhost:5152

# Dépôt du service users : auto (suit l'infra database) | drizzle | mongoose | memory (volatil).
#   (valeurs: auto | drizzle | mongoose | memory · défaut: auto)
# NF_USER_STORE=auto

#   (optionnel)
# NF_STORE=

# Cache d'idempotence : auto (suit l'infra déclarée) | memory (per-pod) | redis | drizzle (distribués cross-pod).
#   (valeurs: auto | memory | redis | drizzle · défaut: auto)
# NF_IDEMPOTENCY_STORE=auto

# Mot de passe de l'admin seedé (dev défaut 'secret-de-dev-42' ; prod requis).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_ADMIN_PASSWORD=

# Mot de passe du compte de fixture 'user' (dev, défaut 'secret-de-dev-42').
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_USER_PASSWORD=

# Backend des endpoints webhook : auto (suit l'infra déclarée) | memory | drizzle (durable).
#   (valeurs: auto | memory | drizzle · défaut: auto)
# NF_WEBHOOK_STORE=auto

# Clé de chiffrement des secrets de signature webhook (prod requis).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_WEBHOOK_KEY=

# Clé de chiffrement des secrets 2FA/TOTP au repos (prod requis, ≥ 32 octets).
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_TOTP_KEY=

# URL publique de l'app comme émetteur de jetons (https) — sans elle, aucune découverte RFC 8414.
#   (optionnel)
# NF_JWT_ISSUER=

# Clé de signature des JWT partagée par tous les pods/workers (JSON une ligne, `security:secrets --jwt-keyset`) — absente : une clé par process.
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_JWT_KEYSET=

# Secret des jetons anti-CSRF (synchronizer) — partagé entre process en cluster.
#   (optionnel · secret : .env sur le poste, gestionnaire de secrets en production)
# NF_CSRF_SECRET=
