# ══════════════════════════════════════════════════════════════════════
#  .env.example — la NOTICE des variables d'environnement
# ══════════════════════════════════════════════════════════════════════
#
#  Commitée, jamais lue au démarrage, aucun secret.
#
#  Pour démarrer :
#
#    cp .env.example .env
#
#  puis, dans .env, retire le « # » devant ce dont tu as besoin.
#
#    .env         TES valeurs, sur ton poste. JAMAIS commité.
#    production   aucun fichier : l'hébergeur fournit les variables.
#
#  Une variable posée dans le terminal l'emporte sur .env.
#  Ce que l'application lit vraiment, et d'où :  npx nodefony env
#
#  Sous chaque variable :
#    @required / @optional   faut-il la poser ?
#    @sensitive              c'est un secret : jamais dans git
#    @default                ce qui s'applique si tu ne poses rien
#
#  Avancé : NF__<MODULE>__<CHEMIN>=valeur règle n'importe quelle clé de
#  configuration ; <NOM>_FILE=/chemin lit un secret monté (Docker, k8s).
#
#  ⚙️  Généré depuis env.ts — ne pas éditer à la main :
#      npx nodefony env --example


# Port d'écoute HTTP.
# @optional
# @default=5151
# NF_PORT=


# Alias plateforme du port HTTP (Cloud Run/Heroku) — NF_PORT gagne.
# @optional
# @default=aucun
# PORT=


# Port d'écoute HTTPS/HTTP2.
# @optional
# @default=5152
# NF_PORT_HTTPS=


# Infra database : URL unique (sqlite:|postgres://|mysql://|mongodb://), dialecte déduit du scheme.
# @optional
# @default=aucun
# NF_DATABASE_URL=


# Infra cache : URL Redis (redis://…) — sa présence charge @nodefony/redis.
# @optional
# @default=aucun
# NF_REDIS_URL=


# Sink d'écriture des logs : stdout | file | null.
# @optional
# @type=enum(stdout, file, null)
# @default=stdout
# NF_LOG_DRIVER=stdout


# Écriture synchrone du sink fichier (writeSync par worker).
# @optional
# @default=false
# NF_LOG_FILE_SYNC=false


# Driver de relecture du log backplane (auto|memory|file|…).
# @optional
# @default=auto
# NF_LOG_QUERY_DRIVER=auto


# URL HTTP de la destination Loki (poussée + relecture).
# @optional
# @default=aucun
# NF_LOKI_URL=


# URL HTTP de la destination OpenSearch (poussée + relecture).
# @optional
# @default=aucun
# NF_OPENSEARCH_URL=


# DEV : bind 0.0.0.0 + trustProxy (banc reverse-proxy Docker).
# @optional
# @default=false
# NF_BIND_ALL=false


# Livraison de l'UI Studio : auto | static (pré-buildé, sans Vite) | vite.
# @optional
# @type=enum(auto, static, vite)
# @default=auto
# NF_STUDIO_UI=auto


# OAuth Google — Client ID (Google Cloud Console).
# @optional
# @default=aucun
# GOOGLE_CLIENT_ID=


# OAuth Google — Client Secret (SECRET, jamais loggé).
# @optional
# @sensitive
# @default=aucun
# GOOGLE_CLIENT_SECRET=


# OAuth GitHub — Client ID (Developer Settings › OAuth Apps).
# @optional
# @default=aucun
# GITHUB_CLIENT_ID=


# OAuth GitHub — Client Secret (SECRET, jamais loggé).
# @optional
# @sensitive
# @default=aucun
# GITHUB_CLIENT_SECRET=


# OIDC Keycloak — émetteur = URL du realm, en https (ex. https://localhost:8444/realms/nodefony).
# @optional
# @sensitive
# @default=aucun
# NF_KEYCLOAK_ISSUER=


# OIDC Keycloak — identifiant du client confidentiel.
# @optional
# @sensitive
# @default=aucun
# NF_KEYCLOAK_CLIENT_ID=


# OIDC Keycloak — secret du client confidentiel (SECRET, jamais loggé).
# @optional
# @sensitive
# @default=aucun
# NF_KEYCLOAK_CLIENT_SECRET=


# Base d'URL des callbacks OAuth. Un fournisseur n'est monté QUE si ses deux secrets sont posés.
# Callback à enregistrer chez lui, EXACTEMENT (RFC 9700) :
#   <NF_OAUTH_REDIRECT_BASE>/nodefony/security/api/oauth2/<provider>/callback
# ⚠️ localhost, PAS 127.0.0.1 : WebAuthn refuse une IP comme rpId.
# Google : si https://localhost est refusé, utiliser http://localhost:5151.
# @optional
# @default=https://localhost:5152
# NF_OAUTH_REDIRECT_BASE=https://localhost:5152


# Dépôt du service users : auto (suit l'infra database) | drizzle | mongoose | memory (volatil).
# @optional
# @type=enum(auto, drizzle, mongoose, memory)
# @default=auto
# NF_USER_STORE=auto


# Force TOUS les stockages en mode auto vers ce backend (ex. memory pour un banc de charge). Vide = aucun forçage.
# @optional
# @default=aucun
# NF_STORE=


# Cache d'idempotence : auto (suit l'infra déclarée) | memory (per-pod) | redis | drizzle (distribués cross-pod).
# @optional
# @type=enum(auto, memory, redis, drizzle)
# @default=auto
# NF_IDEMPOTENCY_STORE=auto


# Mot de passe de l'administrateur semé au premier démarrage.
# @optional
# @sensitive
# @default="secret-de-dev-42 en développement ; aucun en production (aucun compte créé)"
# NF_ADMIN_PASSWORD=


# Mot de passe du compte de fixture « user ».
# @optional
# @sensitive
# @default="secret-de-dev-42 (développement seulement)"
# NF_USER_PASSWORD=


# Backend des endpoints webhook : auto (suit l'infra déclarée) | memory | drizzle (durable).
# @optional
# @type=enum(auto, memory, drizzle)
# @default=auto
# NF_WEBHOOK_STORE=auto


# Clé de chiffrement des secrets de signature webhook (prod requis).
# @optional
# @sensitive
# @default=aucun
# NF_WEBHOOK_KEY=


# Clé de chiffrement des secrets 2FA/TOTP au repos (prod requis, ≥ 32 octets).
# @optional
# @sensitive
# @default=aucun
# NF_TOTP_KEY=


# URL publique de l'app comme émetteur de jetons (https) — sans elle, aucune découverte RFC 8414.
# @optional
# @default=aucun
# NF_JWT_ISSUER=


# Clé de signature des JWT partagée par tous les pods/workers (JSON une ligne, `security:secrets --jwt-keyset`) — absente : une clé par process.
# @optional
# @sensitive
# @default=aucun
# NF_JWT_KEYSET=


# Secret des jetons anti-CSRF (synchronizer) — partagé entre process en cluster.
# @optional
# @sensitive
# @default=aucun
# NF_CSRF_SECRET=
