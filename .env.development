# Variables d'environnement par défaut — environment "development".
# VERSIONNÉ : ne JAMAIS y mettre de secret de production.
#
# Précédence (cf src/nodefony/src/runtime/loadEnv.ts) :
#   process.env (shell/orchestrateur) > .env > .env.local > CE FICHIER.
# Surcharge locale non versionnée : créer un .env.local (gitignoré via *.local).

# Connexion Redis du compose de dev (docker/docker-compose.yml).
# Le mot de passe "nodefony-dev" est PUBLIC (compose committé) → pas un secret.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nodefony-dev
