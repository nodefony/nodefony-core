# Variables d'environnement par défaut — environment "development".
# VERSIONNÉ : ne JAMAIS y mettre de secret. Uniquement des défauts NON-secrets.
#
# Précédence (cf src/nodefony/src/runtime/loadEnv.ts), du plus fort au plus faible :
#   process.env (shell/orchestrateur) > .env > .env.local > CE FICHIER (.env.<env>)
#
# Secrets / overrides machine → .env.local (gitignoré via *.local), JAMAIS ici.

# Connexion Redis du compose de dev (docker/docker-compose.yml).
# Hôte/port = défauts non-secrets. Le mot de passe vit dans .env.local.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD → .env.local (gitignoré)
