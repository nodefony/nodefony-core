{
  "name": "nodefony-core",
  "version": "10.0.0-alpha.1",
  "description": "Core Nodefony Framework",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "private": true,
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "keywords": [
    "nodefony",
    "node-js",
    "javascript"
  ],
  "scripts": {
    "nodefony": "nodefony",
    "start": "nodefony",
    "prepare": "husky",
    "build": "turbo run build && rollup -c",
    "build:force": "turbo run build --force && rollup -c",
    "build:core": "npm run build --workspace=src/nodefony",
    "build:packages": "turbo run build --filter=./src/packages/**",
    "build:front": "nodefony frontend:build",
    "build:all": "npm run build && npm run build:front",
    "clean": "turbo run clean && rimraf dist",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "dev": "npm run dev --workspace=src/nodefony",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "analyze": "npm run analyze --workspace=src/nodefony",
    "certificates": "bash bin/generateCertificates.sh",
    "generate-symbols": "tsx scripts/generate-symbols.ts"
  },
  "workspaces": [
    "src/nodefony",
    "src/packages/@nodefony/*",
    "src/modules/*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "rollup": "4.61.1",
    "rollup-sourcemap-path-transform": "1.2.0",
    "ts-morph": "28.0.0",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "turbo": "^2.9.12",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony-core.git"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md"
}
