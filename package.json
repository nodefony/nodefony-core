{
  "name": "nodefony-core",
  "version": "10.0.0",
  "description": "Core Nodefony Framework",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "node-js",
    "javascript"
  ],
  "scripts": {
    "nodefony": "nodefony",
    "start": "nodefony",
    "prepare": "husky",
    "build": "turbo run build && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "build:force": "turbo run build --force && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "build:core": "npm run build --workspace=src/nodefony",
    "build:packages": "turbo run build --filter=./src/packages/**",
    "build:front": "nodefony frontend:build",
    "build:all": "npm run build && npm run build:front",
    "clean": "turbo run clean && rimraf dist",
    "test": "turbo run build && turbo run test",
    "posttest": "node -e \"console.log('\\n\\x1b[33m⚠  npm test = suites unitaires seules — ni serveur, ni base.\\n   Image complète (infra + intégration) : \\x1b[1mnpm run test:all\\x1b[0m\\x1b[33m\\x1b[0m\\n')\"",
    "test:all": "tsx scripts/test-all.ts",
    "test:integration": "turbo run build && turbo run test:integration",
    "test:load": "turbo run build && turbo run test:load",
    "test:memory": "turbo run build && turbo run test:memory",
    "test:boot": "turbo run build && turbo run test:boot",
    "dev": "npm run dev --workspace=src/nodefony",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "certificates": "bash bin/generateCertificates.sh",
    "generate-symbols": "tsx scripts/generate-symbols.ts",
    "skills:check": "node .claude/skills/nodefony-skill/scripts/skills-doc.mjs --check && node .claude/skills/nodefony-skill/scripts/trigger-bench.mjs && node .claude/skills/nodefony-skill/scripts/scripts-audit.mjs --strict",
    "skills:doc": "node .claude/skills/nodefony-skill/scripts/skills-doc.mjs"
  },
  "workspaces": [
    "src/nodefony",
    "src/packages/@nodefony/*",
    "src/modules/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "nodemon": "3.1.14",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "rolldown": "1.1.5",
    "ts-morph": "28.0.0",
    "tslib": "2.8.1",
    "tsx": "4.23.0",
    "turbo": "^2.10.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony-core.git"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "nodefony": {
    "check": {
      "typeCycles": {
        "nodefony": [
          "@nodefony/http",
          "@nodefony/framework"
        ],
        "@nodefony/http": [
          "@nodefony/framework",
          "@nodefony/security"
        ]
      },
      "typesUnreachable": [
        "@nodefony/http",
        "@nodefony/framework",
        "@nodefony/security",
        "@nodefony/user",
        "@nodefony/orm-core"
      ]
    }
  }
}
