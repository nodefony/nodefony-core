{
  "name": "nodefony-core",
  "version": "10.0.0",
  "description": "Dépôt de développement du framework Nodefony — le framework lui-même, ses paquets, et l'application qui l'éprouve en continu",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nodefony",
    "framework",
    "typescript",
    "esm",
    "nodejs",
    "monorepo"
  ],
  "scripts": {
    "board:snapshot": "node .claude/skills/nodefony-session/scripts/board-snapshot.mjs",
    "build": "turbo run build && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "build:all": "npm run build && npm run build:front",
    "build:core": "npm run build --workspace=src/nodefony",
    "build:force": "turbo run build --force && rolldown -c rolldown.config.ts && tsgo -p tsconfig.declarations.json",
    "build:front": "node src/nodefony/bin/nodefony frontend:build",
    "build:packages": "turbo run build --filter=./src/packages/**",
    "certificates": "bash bin/generateCertificates.sh",
    "check:filenames": "node scripts/check-portable-filenames.mjs",
    "check:nul": "node scripts/check-no-nul-bytes.mjs",
    "clean": "turbo run clean && rimraf dist",
    "coverage": "tsx scripts/coverage-all.ts",
    "deps:check": "node scripts/check-deps-latest.mjs",
    "dev": "npm run dev --workspace=src/nodefony",
    "devkit:selftest": "node .claude/skills/nodefony-devkit-bench/scripts/selftests.mjs",
    "env:snapshot": "tsx scripts/env-snapshot.ts",
    "externals:check": "node scripts/check-externals.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:scaffold": "node scripts/check-scaffold-format.mjs",
    "format:templates": "node scripts/format-templates.mjs",
    "generate-symbols": "tsx scripts/generate-symbols.ts",
    "lint": "oxlint --deny-warnings",
    "nodefony": "nodefony",
    "prepare": "git config core.hooksPath .githooks",
    "release": "node scripts/release/release.mjs",
    "release:pack": "node scripts/release/pack-all.mjs",
    "release:smoke": "bash scripts/release/smoke-docker.sh",
    "size:check": "node scripts/size-check.mjs",
    "skills:check": "node .claude/skills/nodefony-skill/scripts/skills-doc.mjs --check && node .claude/skills/nodefony-skill/scripts/trigger-bench.mjs && node .claude/skills/nodefony-skill/scripts/scripts-audit.mjs --strict",
    "skills:doc": "node .claude/skills/nodefony-skill/scripts/skills-doc.mjs",
    "start": "nodefony",
    "test": "turbo run build && turbo run test --continue",
    "posttest": "node -e \"console.log('\\n\\x1b[33m⚠  npm test = suites unitaires seules — ni serveur, ni base.\\n   Image complète (infra + intégration) : \\x1b[1mnpm run test:all\\x1b[0m\\x1b[33m\\x1b[0m\\n')\"",
    "test:all": "tsx scripts/test-all.ts",
    "test:boot": "turbo run build && turbo run test:boot --continue",
    "test:externals": "vitest run scripts/check-externals.test.mjs",
    "test:integration": "turbo run build && turbo run test:integration --continue",
    "test:load": "turbo run build && turbo run test:load",
    "test:memory": "turbo run build && turbo run test:memory",
    "test:pilotage": "vitest run .claude/skills/nodefony-ticket/scripts/ticket-progress.test.mjs .claude/skills/nodefony-ticket/scripts/ticket-open.test.mjs .claude/skills/nodefony-ticket/scripts/ticket-close.test.mjs .claude/skills/nodefony-ticket/scripts/board-lint.test.mjs",
    "test:release": "vitest run scripts/release/",
    "ticket:lint": "node .claude/skills/nodefony-ticket/scripts/board-lint.mjs",
    "ticket:open": "node .claude/skills/nodefony-ticket/scripts/ticket-open.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && node src/nodefony/bin/nodefony doctor"
  },
  "workspaces": [
    "src/nodefony",
    "src/packages/@nodefony/*",
    "src/packages/create-nodefony",
    "src/modules/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.0",
    "vitest": "5.0.0",
    "echarts": "6.1.0",
    "fast-glob": "3.3.3",
    "lighthouse": "13.4.1",
    "lint-staged": "17.4.1",
    "markdown-it": "15.0.1",
    "nodemon": "3.1.14",
    "oxlint": "1.81.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "rolldown": "1.2.7",
    "ts-morph": "28.0.0",
    "tslib": "2.8.1",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nodefony/nodefony-core.git"
  },
  "resolutions": {},
  "license": "CECILL-B",
  "licenses": [
    {
      "type": "CECILL-B",
      "url": "http://www.cecill.info/licences/Licence_CeCILL-B_V1-en.html"
    }
  ],
  "author": "Christophe CAMENSULI <ccamensuli@gmail.com>",
  "readmeFilename": "README.md",
  "nodefony": {
    "doctor": {
      "typeCycles": {
        "nodefony": [
          "@nodefony/http",
          "@nodefony/framework"
        ],
        "@nodefony/http": [
          "@nodefony/framework",
          "@nodefony/security"
        ]
      },
      "entityDialect": [
        "entity/dolibarr/bench-pg.ts"
      ],
      "typesUnreachable": [
        "@nodefony/http",
        "@nodefony/framework",
        "@nodefony/security",
        "@nodefony/user",
        "@nodefony/orm-core"
      ]
    }
  },
  "dependencies": {
    "@analogjs/vite-plugin-angular": "2.7.1",
    "@angular/build": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "@angular/build": {
      "vitest": "$vitest"
    }
  }
}
