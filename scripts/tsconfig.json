{
  // Tsconfig de LINT de l'outillage, jamais de build. Sans lui, les scripts
  // `.mjs` n'appartiennent à aucun projet : le lint typé les rattache à un
  // projet inféré qui dépend du chemin passé à oxlint, et rend des verdicts
  // différents (faux constats fichier par fichier, constats réels tus depuis
  // la racine). Avec lui, un seul verdict, le vrai. Étend la racine, qui
  // n'est pas modifiée.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    // Les scripts s'exécutent sous Node sans build : il exige l'extension `.ts`.
    "allowImportingTsExtensions": true,
    // Le lib du CŒUR : un script qui importe une source du cœur (générateurs
    // de `generate/`) la type comme le cœur la compile. Sans lui, la racine
    // (ES2024) refuse ce que le cœur emploie — `static override isError`.
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["**/*.mjs", "**/*.js", "**/*.ts"],
  "exclude": ["**/node_modules/**", "**/references/**", "**/dist/**"]
}
