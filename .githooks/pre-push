#!/usr/bin/env sh

# Typecheck strict (tsc --noEmit) AVANT chaque push — attrape les erreurs TS
# invisibles au build rollup (ex. TS18036) ; c'est le bug qui avait cassé la CI.
#
# BUILD d'ABORD (turbo, caché) : le core `nodefony` IMPORTE @nodefony/http (et
# transitivement framework/security/user/orm-core) alors que ces packages ne sont
# PAS des dépendances turbo du core (cycle inversé : http dépend du core, pas
# l'inverse). Conséquence : `turbo run typecheck` lance le typecheck du core EN
# PARALLÈLE du build de ces packages (déclenché par d'autres workspaces) → RACE :
# le core typecheck avant que leurs `dist/types` existent → TS2307 « Cannot find
# module @nodefony/user / @nodefony/orm-core » → `git push` bloqué (friction vue 3×).
# Builder TOUT avant lève la race (caché → ~qq s si à jour). `npx` : un hook git
# n'a pas node_modules/.bin dans son PATH. Bypass d'urgence : git push --no-verify.
#
# FORMAT des fichiers POUSSÉS : le pre-commit (lint-staged) ne voit ni un commit
# `--no-verify`, ni un cherry-pick, ni un rebase — vécu : un WIP --no-verify
# repris par cherry-pick a rougi la CI (`format:check`). Le push est le dernier
# point de passage commun ; seuls les fichiers du diff amont..HEAD sont lus.
if git rev-parse --verify -q '@{u}' >/dev/null; then
  pushed=$(git diff --name-only --diff-filter=ACMR '@{u}' HEAD)
  if [ -n "$pushed" ]; then
    echo "$pushed" | tr '\n' '\0' | xargs -0 npx prettier --check --ignore-unknown --no-error-on-unmatched-pattern || {
      echo "pre-push : fichiers poussés non formatés — npx prettier --write <fichier>, puis commit." >&2
      exit 1
    }
  fi
fi
npx turbo run build && npm run typecheck
