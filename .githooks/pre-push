#!/usr/bin/env sh

# Typecheck strict (tsc --noEmit) AVANT chaque push — attrape les erreurs TS
# invisibles au build rollup (ex. TS18036) ; c'est le bug qui avait cassé la CI.
#
# BUILD d'ABORD (turbo, caché) : le core `nodefony` IMPORTE @nodefony/http (et
# transitivement framework/security/user/orm-core) alors que ces packages ne sont
# PAS des dépendances turbo du core (cycle inversé : http dépend du core, pas
# l'inverse). Conséquence : `turbo run typecheck` lance le typecheck du core EN
# PARALLÈLE du build de ces packages (déclenché par d'autres workspaces) → RACE :
# le core typecheck avant que leurs `dist/types` existent → TS2307 « Cannot find
# module @nodefony/user / @nodefony/orm-core » → `git push` bloqué (friction vue 3×).
# Builder TOUT avant lève la race (caché → ~qq s si à jour). `npx` : un hook git
# n'a pas node_modules/.bin dans son PATH. Bypass d'urgence : git push --no-verify.
#
# FORMAT des fichiers POUSSÉS : le pre-commit (lint-staged) ne voit ni un commit
# `--no-verify`, ni un cherry-pick, ni un rebase — vécu : un WIP --no-verify
# repris par cherry-pick a rougi la CI (`format:check`). Le push est le dernier
# point de passage commun ; seuls les fichiers du diff amont..HEAD sont lus.
if git rev-parse --verify -q '@{u}' >/dev/null; then
  pushed=$(git diff --name-only --diff-filter=ACMR '@{u}' HEAD)
  if [ -n "$pushed" ]; then
    echo "$pushed" | tr '\n' '\0' | xargs -0 npx prettier --check --ignore-unknown --no-error-on-unmatched-pattern || {
      echo "" >&2
      echo "❌ pre-push REFUSÉ : des fichiers poussés ne sont pas au format (liste ci-dessus)." >&2
      echo "   Pourquoi : la CI rejoue le même contrôle (format:check) et tomberait rouge ; un" >&2
      echo "   commit --no-verify, un cherry-pick ou un rebase échappent au formatage du commit." >&2
      echo "   Faire : npx prettier --write <fichier>…" >&2
      echo "   Puis  : git add <fichier>… && git commit -m 'style: formater' && git push" >&2
      exit 1
    }
    # ANCRES de la doc vers le code (#613) : elles s'écrivent `<fichier>#<Symbole>`
    # et ne cassent qu'au renommage ou à la suppression du symbole — quand la doc
    # DOIT suivre. Une ancre `fichier:ligne` est refusée : elle mentait au premier
    # ajout de ligne au-dessus d'elle, et la recaler coûtait plus que la doc
    # entière. Corpus = celui de la CI (`node.js.yml`, gate « ancres de la
    # doc ») : pages publiées ET `references/` des skills.
    if echo "$pushed" | grep -qE '\.(ts|tsx|mts|md)$'; then
      anchors=.claude/skills/nodefony-documentation/scripts/anchor-check.mjs
      { node scripts/site/build-docs-site.mjs --list | tr '\n' '\0' | xargs -0 node "$anchors" >/dev/null &&
        find .claude/skills -path '*/references/*.md' -not -path '*/rfc/*' -not -path '*/specs/*' -print0 |
        xargs -0 node "$anchors" >/dev/null; } || {
        echo "pre-push REFUSÉ : une ancre de la doc vers le code est fausse." >&2
        echo "  Pourquoi : un symbole cité a été renommé ou supprimé (SYMBOL_NOT_FOUND), ou une page" >&2
        echo "  écrit une ancre \`fichier:ligne\` (LINE_ANCHOR), qui ment au premier ajout de ligne." >&2
        echo "  La CI refuserait le même push (gate « ancres de la doc »)." >&2
        echo "  Voir lesquelles : node $anchors \$(node scripts/site/build-docs-site.mjs --list) | grep -A3 '^❌'" >&2
        echo "  LINE_ANCHOR → node ${anchors%/*}/anchor-migrate.mjs <pages> --apply l'écrit en symbole." >&2
        echo "  SYMBOL_NOT_FOUND → la page suit le code : écrire le nouveau nom du symbole." >&2
        exit 1
      }
    fi
  fi
fi
# Le dernier verdict n'avait aucun message : turbo et tsc impriment l'erreur,
# mais rien ne disait que le PUSH était refusé, ni par où reprendre.
npx turbo run build || {
  echo "" >&2
  echo "❌ pre-push REFUSÉ : le build a échoué (erreur ci-dessus, préfixée du paquet « @nodefony/x:build: »)." >&2
  echo "   Pourquoi : la CI reconstruit tout depuis zéro ; ce qui ne se construit pas ici n'y passera pas." >&2
  echo "   Faire : corriger, puis rejouer seul : npx turbo run build --filter=<paquet>" >&2
  echo "   Si l'erreur cite un export ou un fichier qui existe pourtant : npm run clean && npm run build" >&2
  echo "   (dist périmé après un pull, un merge ou un changement d'index.ts)." >&2
  echo "   Puis  : git commit && git push" >&2
  exit 1
}
npm run typecheck || {
  echo "" >&2
  echo "❌ pre-push REFUSÉ : erreur de typage (fichier:ligne et code TSxxxx ci-dessus)." >&2
  echo "   Pourquoi : le build (rolldown) ne vérifie pas les types — une erreur TS passe le build," >&2
  echo "   et c'est la CI qui tomberait. Il couvre aussi les tests et les scripts du dépôt." >&2
  echo "   Faire : corriger, puis rejouer : npm run typecheck" >&2
  echo "   « Cannot find module @nodefony/… » (TS2307) sur un paquet existant : npm run build d'abord." >&2
  echo "   Puis  : git commit && git push" >&2
  exit 1
}
