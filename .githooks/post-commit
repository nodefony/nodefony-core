#!/bin/sh
# Le statut d'un ticket se DÉRIVE du premier commit qui le cite — voir l'en-tête de
# .claude/skills/nodefony-ticket/scripts/ticket-progress.mjs. Détaché et silencieux : un hook post-commit ne doit
# ni ralentir le commit, ni le faire échouer (il a déjà eu lieu de toute façon).
[ -n "$NF_NO_TICKET_PROGRESS" ] && exit 0
(node "$(git rev-parse --show-toplevel)/.claude/skills/nodefony-ticket/scripts/ticket-progress.mjs" >/dev/null 2>&1 &) 
# Le graphe symbolique n'est pas versionné : il se régénère après le commit.
sh "$(git rev-parse --show-toplevel)/.githooks/_symbols.sh" HEAD~1 HEAD
exit 0
