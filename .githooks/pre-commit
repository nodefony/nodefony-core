#!/usr/bin/env sh

# Un run long (`test:all`) lit l'arbre pendant des dizaines de minutes : un
# commit en plein milieu signe un état que sa passe n'a pas testé, et rend son
# verdict invérifiable. Vécu : deux campagnes invalidées. En tête, parce qu'il
# ne coûte qu'une lecture de fichier.
if ! node scripts/repo/long-run-lock.mjs check; then
  exit 1
fi

# Formatage auto des fichiers staged (prettier via lint-staged).
# NON bloquant pour ton workflow : prettier --write réussit toujours sur du code
# valide ; il reformate, il ne refuse pas. Bypass d'urgence : git commit --no-verify.
npx --no-install lint-staged || {
  echo "" >&2
  echo "❌ pre-commit REFUSÉ : lint-staged — oxlint a trouvé une faute (règle et fichier:ligne ci-dessus)," >&2
  echo "   ou prettier n'a pas pu lire un fichier (erreur de syntaxe)." >&2
  echo "   Pourquoi : la CI lance le même oxlint en --deny-warnings ; un avertissement y est un rouge." >&2
  echo "   Faire : corriger la ligne citée, ou relire l'aide de la règle : npx oxlint --rules | grep <règle>" >&2
  echo "   Ne PAS faire taire la règle par un commentaire « oxlint-disable » sans la raison écrite à côté." >&2
  echo "   Puis  : git add <fichier> && git commit   (tes modifications non indexées sont intactes)" >&2
  exit 1
}

# Garde de PORTABILITÉ : un nom de fichier que Windows refuse rend le dépôt
# INCLONABLE là-bas — `git checkout` sort en 128 sur `invalid path`, avant le
# moindre test, pendant que linux et macOS restent verts. Aucun lint ne regarde
# les NOMS. Vécu : un `touch` lancé par un test d'attaque a créé deux fichiers à
# la racine, `git add -A` les a emportés, sept jobs Windows sont tombés.
# Placée en tête : elle coûte un `git diff --cached` et ferme une porte qu'aucun
# autre gate ne voit.
if ! node scripts/gates/check-portable-filenames.mjs --staged; then
  exit 1
fi

# Frère du précédent, sur le CONTENU : un octet NUL dans une source la fait
# passer pour BINAIRE aux yeux de grep et rg, qui cessent d'en rendre les lignes.
# Le fichier compile, ses tests passent, et il a disparu de toute recherche du
# dépôt — sans un mot. Vécu : trois recherches muettes pendant un diagnostic,
# dont une preuve d'ABSENCE qui aurait été fausse. `\0` échappé produit la même
# chaîne à l'exécution, donc la garde n'a pas d'échappatoire.
if ! node scripts/gates/check-no-nul-bytes.mjs --staged; then
  exit 1
fi

# Un script shell qui ne se PARSE pas meurt en cours d'exécution, jamais au
# moment où on l'écrit. Vécu : une apostrophe dans un commentaire de `node -e '…'`
# a coupé le smoke de release après seize tarballs bâtis. `bash -n` ne lance rien.
if ! node scripts/gates/check-shell-syntax.mjs --staged; then
  exit 1
fi

# Les contrôles en lecture seule (langue des identifiants, skills, gabarits,
# cliquets…) vivent dans `_read-only-gates.sh`, lancé par `commit-msg` APRÈS
# commitlint : un message refusé tombe avant eux, sans les faire attendre.


# Catalogue des variables d'environnement — même patron que les symboles, et
# placé AVANT parce que le bloc suivant se termine par un `exit 0`.
#
# Pré-filtre en shell pur : une variable ne peut apparaître que dans un fichier
# de code, et seulement s'il contient la chaîne « NF_ ». Sur la grande majorité
# des commits, rien ne démarre. Sans ce filtre, on paierait 2 s de scan pour
# corriger une faute de frappe dans un markdown.
#
# Second déclencheur, sans filtre de contenu : les REGISTRES dont naît la page
# publique docs/guides/variables-environnement.md. Retoucher le seul défaut
# d'un réglage ne fait apparaître aucun « NF_ » dans le diff — la page publiée
# garderait l'ancien défaut sans que rien ne le dise.
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(src|scripts)/.*\.(ts|tsx|mts|mjs|js)$' || true)
ENV_REGISTRIES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(src/nodefony/src/config/(reservedEnv|envExample)\.ts|src/nodefony/templates/app/base/env\.ts\.tpl|src/packages/@nodefony/[^/]+/nodefony/config/[^/]+\.ts|scripts/generate/env-(reference|snapshot)\.ts)$' || true)
if [ -n "$ENV_REGISTRIES" ] || { [ -n "$ENV_FILES" ] && git diff --cached -U0 -- $ENV_FILES | grep -q 'NF_'; }; then
  if ! npx tsx scripts/generate/env-snapshot.ts; then
    echo "❌ pre-commit REFUSÉ : catalogue des variables d'environnement (variable citée ci-dessus)." >&2
    echo "   Pourquoi : une variable NF_ lue sans description fait sauter un banc sans un mot — et un" >&2
    echo "   banc sauté compte comme vert ; une description sans lecture ment sur ce qui est lu." >&2
    echo "   Faire : le geste et le fichier du catalogue sont ci-dessus — décrire la variable de banc," >&2
    echo "   ou retirer la description orpheline." >&2
    echo "   Puis  : git add .ai/env.json .ai/ENV.md docs/guides/variables-environnement.md <fichier> && git commit" >&2
    exit 1
  fi
  if ! git diff --quiet .ai/env.json .ai/ENV.md docs/guides/variables-environnement.md 2>/dev/null; then
    git add .ai/env.json .ai/ENV.md docs/guides/variables-environnement.md
    echo "✅ .ai/env.json + .ai/ENV.md + docs/guides/variables-environnement.md mis à jour et stagés"
  fi
fi

# Le graphe symbolique (.ai/symbols.json) n'est PLUS régénéré ici : il n'est pas
# versionné. Les hooks post-commit / post-merge / post-checkout le régénèrent en
# arrière-plan — le commit ne paie plus les ~10 s de génération.
