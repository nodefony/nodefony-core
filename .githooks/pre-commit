#!/usr/bin/env sh

# Formatage auto des fichiers staged (prettier via lint-staged).
# NON bloquant pour ton workflow : prettier --write réussit toujours sur du code
# valide ; il reformate, il ne refuse pas. Bypass d'urgence : git commit --no-verify.
npx --no-install lint-staged || exit 1

# Garde de PORTABILITÉ : un nom de fichier que Windows refuse rend le dépôt
# INCLONABLE là-bas — `git checkout` sort en 128 sur `invalid path`, avant le
# moindre test, pendant que linux et macOS restent verts. Aucun lint ne regarde
# les NOMS. Vécu : un `touch` lancé par un test d'attaque a créé deux fichiers à
# la racine, `git add -A` les a emportés, sept jobs Windows sont tombés.
# Placée en tête : elle coûte un `git diff --cached` et ferme une porte qu'aucun
# autre gate ne voit.
if ! node scripts/check-portable-filenames.mjs --staged; then
  exit 1
fi

# Frère du précédent, sur le CONTENU : un octet NUL dans une source la fait
# passer pour BINAIRE aux yeux de grep et rg, qui cessent d'en rendre les lignes.
# Le fichier compile, ses tests passent, et il a disparu de toute recherche du
# dépôt — sans un mot. Vécu : trois recherches muettes pendant un diagnostic,
# dont une preuve d'ABSENCE qui aurait été fausse. `\0` échappé produit la même
# chaîne à l'exécution, donc la garde n'a pas d'échappatoire.
if ! node scripts/check-no-nul-bytes.mjs --staged; then
  exit 1
fi

# Garde anti-dérive : `.env.example` est GÉNÉRÉ depuis env.ts (catalogue defineEnv).
# Si env.ts, .env.example ou l'en-tête curé est staged, vérifier qu'ils sont
# synchronisés (sinon une var ajoutée à env.ts mais pas régénérée passerait). Placé
# AVANT le pré-filtre .ts pour aussi attraper un .env.example édité à la main (non-.ts).
# La commande lit env.ts EN SOURCE (pas le dist) : un build en retard ne fait pas
# mentir le gate. C'est la commande du framework — le dépôt consomme la sienne.
if git diff --cached --name-only --diff-filter=ACMR \
   | grep -qE '^(env\.ts|\.env\.example|\.env\.example\.head)$'; then
  if ! npx --no-install nodefony env --example --check; then
    echo "❌ .env.example désynchronisé de env.ts."
    echo "   → npx nodefony env --example  puis  git add .env.example"
    exit 1
  fi
fi

# Garde anti-dérive : les fiches publiques des skills sont GÉNÉRÉES depuis les
# `SKILL.md`. Toucher un skill sans les régénérer publie une doc qui ment, avec
# l'autorité du généré — et le rouge ne tombait qu'en CI, un aller-retour plus
# tard. Vécu le jour même où ce contrôle est né : une modification de script de
# skill, deux fiches périmées, un job rouge.
# La garde publiée en compte TROIS (fraîcheur des fiches, déclencheurs, audit des
# scripts) et le hook n'en lançait qu'UNE : un script de skill que personne
# n'appelle passait donc ici pour se faire refuser vingt minutes plus tard en
# forge. Une règle appliquée à un seul de ses frères n'est pas appliquée — et
# l'ensemble coûte UNE seconde, ce qui ne laisse aucun argument à l'asymétrie.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^\.claude/skills/'; then
  if ! npm run --silent skills:check; then
    echo "   → corriger ci-dessus (fiches : npm run skills:doc puis git add docs/skills)"
    exit 1
  fi
fi

# Garde anti-dérive : les noms de canaux/méthodes de plateforme (`nodefony:*`) ne
# s'écrivent pas en dur — ils viennent de la table du cœur. Un producteur renommé
# sans son consommateur rend un écran muet SANS qu'aucun test ne rougisse (les
# écrans n'en ont pas) ; seule la table, donc le compilateur, ferme cette porte.
# Filtre .tsx inclus : le front est justement la zone non testée.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.tsx?$'; then
  if ! node scripts/check-platform-channels.mjs; then
    echo "   → importer PLATFORM_CHANNELS / PLATFORM_METHODS / PLATFORM_EVENTS depuis \"nodefony\""
    exit 1
  fi
fi

# Garde anti-dérive : un paquet qui importe sans déclarer ne casse RIEN ici (npm
# hisse tout à la racine) — il casse l'ordre de build après un `clean`, et
# l'installation chez le consommateur. Deux endroits où nous ne sommes jamais.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '(\.tsx?|package\.json)$'; then
  if ! node scripts/check-package-deps.mjs; then
    exit 1
  fi
fi

# Catalogue des variables d'environnement — même patron que les symboles, et
# placé AVANT parce que le bloc suivant se termine par un `exit 0`.
#
# Pré-filtre en shell pur : une variable ne peut apparaître que dans un fichier
# de code, et seulement s'il contient la chaîne « NF_ ». Sur la grande majorité
# des commits, rien ne démarre. Sans ce filtre, on paierait 2 s de scan pour
# corriger une faute de frappe dans un markdown.
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(src|scripts)/.*\.(ts|tsx|mts|mjs|js)$' || true)
if [ -n "$ENV_FILES" ] && git diff --cached -U0 -- $ENV_FILES | grep -q 'NF_'; then
  if ! npx tsx scripts/env-snapshot.ts; then
    echo "❌ catalogue des variables d'environnement — commit annulé"
    echo "   Une variable de décor lue sans description, ou décrite sans lecture."
    exit 1
  fi
  if ! git diff --quiet .ai/env.json .ai/ENV.md 2>/dev/null; then
    git add .ai/env.json .ai/ENV.md
    echo "✅ .ai/env.json + .ai/ENV.md mis à jour et stagés"
  fi
fi

# Pré-filtre rapide (shell pur, AUCUN boot node) : si aucun .ts n'est staged,
# il n'y a rien à régénérer → on évite ~1,3 s de démarrage node/tsx sur les
# commits sans code (docs, config, json…). Réduit aussi la fenêtre pendant
# laquelle une interruption (crash terminal, Ctrl+C) peut laisser un
# .git/index.lock orphelin. Le check précis (zone parsée des globs) reste
# délégué au script node ci-dessous pour ne pas dupliquer la config (dérive).
if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '\.ts$'; then
  exit 0
fi

# Régénère .ai/symbols.json si des .ts dans la zone parsée sont staged.
# La zone parsée est définie UNIQUEMENT dans scripts/generate-symbols.config.ts
# (include/exclude globs). Ce hook délègue au mode --check-staged du script.

if npm run generate-symbols --silent -- --check-staged; then
  # exit 0 → rien dans la zone parsée → skip
  exit 0
fi

echo "🔄 .ts modifiés dans la zone parsée → régénération .ai/symbols.json..."

if ! npm run generate-symbols --silent; then
  echo "❌ generate-symbols a échoué — commit annulé"
  exit 1
fi

# Si le JSON a changé, le stager dans le commit en cours
if ! git diff --quiet .ai/symbols.json 2>/dev/null; then
  git add .ai/symbols.json
  echo "✅ .ai/symbols.json mis à jour et stagé"
fi
